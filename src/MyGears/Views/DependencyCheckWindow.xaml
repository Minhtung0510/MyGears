<Window x:Class="MyGears.Views.DependencyCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MyGears.ViewModels"
        Title="MyGears — Kiểm tra hệ thống / System Check"
        Width="700" Height="520"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D"
        BorderBrush="#E8321A" BorderThickness="1"
        WindowStyle="None" ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:DependencyCheckViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>   <!-- Titlebar -->
            <RowDefinition Height="100"/>  <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Dep list -->
            <RowDefinition Height="120"/>  <!-- Log -->
            <RowDefinition Height="60"/>   <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ── Custom Title Bar ───────────────────────── -->
        <Border Grid.Row="0" Background="#141414"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚙" FontSize="18" Foreground="#E8321A" VerticalAlignment="Center"/>
                    <TextBlock Text=" MyGears" FontSize="14" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <TextBlock Text=" — Kiểm tra hệ thống / System Check"
                               FontSize="12" Foreground="#888" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right"
                        Width="40" Height="40"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#888" FontSize="14" Cursor="Hand"
                        Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="#888"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                Width="40" Height="40">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#C0392B"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- ── Header: Logo + Status ─────────────────── -->
        <Border Grid.Row="1" Background="#141414" BorderBrush="#1F1F1F" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Logo accent line -->
                <Border Grid.Column="0" Width="4" Height="60" CornerRadius="2"
                        Margin="0,0,16,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#E8321A" Offset="0"/>
                            <GradientStop Color="#FF6B2B" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding OverallStatus}" FontSize="15"
                               FontWeight="SemiBold" Foreground="White"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="USB Root: " Foreground="#666" FontSize="11"/>
                        <TextBlock x:Name="UsbRootText" Foreground="#888" FontSize="11"
                                   FontFamily="Consolas"/>
                    </StackPanel>

                    <!-- Progress bar -->
                    <Grid Margin="0,8,24,0">
                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Dependency List ───────────────────────── -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Background="#0D0D0D" Margin="0,4,0,0">
            <ItemsControl ItemsSource="{Binding Items}" Margin="16,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#141414" CornerRadius="6" Margin="0,3"
                                Padding="14,10" BorderBrush="#1F1F1F" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding StatusIcon}"
                                           FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                           Foreground="#DEDEDE" FontSize="13"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                                           Foreground="#888" FontSize="11"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ── Log Panel ─────────────────────────────── -->
        <Border Grid.Row="3" Background="#0A0A0A" BorderBrush="#1F1F1F" BorderThickness="0,1,0,1">
            <Grid>
                <TextBlock Text="LOG" Foreground="#555" FontSize="10" FontFamily="Consolas"
                           Margin="12,6,0,0" VerticalAlignment="Top"/>
                <ScrollViewer x:Name="LogScrollViewer" Margin="12,22,12,8"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                                           Foreground="#667" TextWrapping="Wrap" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ── Footer ────────────────────────────────── -->
        <Border Grid.Row="4" Background="#141414">
            <Grid Margin="16,0">
                <TextBlock Text="Chạy với quyền Administrator để cài dependency / Run as Admin for silent install"
                           Foreground="#555" FontSize="11" VerticalAlignment="Center"/>
                <Button Content="Tiếp tục → / Continue →"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Right" Margin="0,8"
                        IsEnabled="{Binding IsComplete}"
                        Click="ContinueButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
