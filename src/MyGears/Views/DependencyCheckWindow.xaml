<Window x:Class="MyGears.Views.DependencyCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MyGears.ViewModels"
        Title="MyGears — Kiểm tra hệ thống / Diagnostic Console"
        Width="720" Height="530"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeep}"
        BorderBrush="{StaticResource AccentBrass}" BorderThickness="1.2"
        WindowStyle="None" ResizeMode="NoResize"
        FontFamily="{StaticResource AppFont}">

    <Window.DataContext>
        <vm:DependencyCheckViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>   <!-- Titlebar -->
            <RowDefinition Height="104"/>  <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Dep list -->
            <RowDefinition Height="125"/>  <!-- Log -->
            <RowDefinition Height="64"/>   <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ── Custom Title Bar ───────────────────────── -->
        <Border Grid.Row="0" Background="{StaticResource BgSidebar}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚙" FontSize="18" Foreground="{StaticResource AccentGold}" VerticalAlignment="Center"
                               Style="{StaticResource SlowGearSpinStyle}"/>
                    <TextBlock Text=" MyGears" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <Border Background="#262118" CornerRadius="3" Padding="5,2" Margin="8,0,0,0"
                            BorderBrush="{StaticResource AccentBrass}" BorderThickness="0.8">
                        <TextBlock Text="DIAGNOSTIC CONSOLE" FontSize="9.5" FontWeight="Bold"
                                   Foreground="{StaticResource AccentGold}" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right"
                        Width="40" Height="48"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource TextSecondary}" FontSize="13" Cursor="Hand"
                        Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" Width="40" Height="48">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource VintageRuby}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- ── Header: Status + Progress ──────────────── -->
        <Border Grid.Row="1" Background="{StaticResource PlateBevelGradient}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Brass accent line with amber glow -->
                <Border Grid.Column="0" Width="4" Height="64" CornerRadius="2"
                        Background="{StaticResource AccentGradient}" Margin="0,0,18,0">
                    <Border.Effect>
                        <DropShadowEffect Color="{StaticResource AccentAmberColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.7"/>
                    </Border.Effect>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding OverallStatus}" FontSize="15"
                               FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="USB Root: " Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        <TextBlock x:Name="UsbRootText" Foreground="{StaticResource AccentGold}" FontSize="11"
                                   FontFamily="{StaticResource MonoFont}"/>
                    </StackPanel>

                    <!-- Progress bar -->
                    <Grid Margin="0,10,24,0">
                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="8"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Dependency List ───────────────────────── -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Background="{StaticResource BgContent}" Margin="0,2,0,0">
            <ItemsControl ItemsSource="{Binding Items}" Margin="16,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource PlateBevelGradient}" CornerRadius="7" Margin="0,4"
                                Padding="16,12" BorderBrush="{StaticResource BorderCard}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding StatusIcon}"
                                           FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                           Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                                           Foreground="{StaticResource AccentGold}" FontSize="11.5"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ── Log Panel (Vintage CRT Phosphor Console) ─ -->
        <Border Grid.Row="3" Background="#0A0C10" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,1">
            <Grid>
                <TextBlock Text="DIAGNOSTIC LOG" Foreground="{StaticResource AccentBrass}" FontSize="9.5" FontWeight="Bold"
                           FontFamily="{StaticResource MonoFont}" Margin="14,6,0,0" VerticalAlignment="Top"/>
                <ScrollViewer x:Name="LogScrollViewer" Margin="14,24,14,8"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="#A8A29E" TextWrapping="Wrap" Margin="0,1.5"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ── Footer ────────────────────────────────── -->
        <Border Grid.Row="4" Background="{StaticResource BgSidebar}">
            <Grid Margin="16,0">
                <TextBlock Text="Chạy với quyền Administrator để cài dependency / Run as Admin for silent install"
                           Foreground="{StaticResource TextMuted}" FontSize="11"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>

                <!-- Nút Tiếp tục -->
                <Button x:Name="ContinueButton"
                        Content="Tiếp tục → / Continue →"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Height="38" Padding="18,0" FontSize="12.5"
                        Click="ContinueButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
