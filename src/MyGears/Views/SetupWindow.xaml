<Window x:Class="MyGears.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:MyGears.Core"
        xmlns:vm="clr-namespace:MyGears.ViewModels"
        Title="MyGears — Cài Đặt Vào Máy Tính"
        Width="740" Height="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Arial, sans-serif">

    <Window.DataContext>
        <vm:SetupViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <core:InverseBooleanConverter x:Key="InvertBoolConverter"/>
        <core:InverseBooleanToVisibilityConverter x:Key="InvertBoolToVisConverter"/>
        <core:DoubleToPercentageConverter x:Key="DoubleToPctConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Sleek Dark Gaming CheckBox -->
        <Style x:Key="GamingCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid VerticalAlignment="Center">
                            <Border x:Name="Box" Width="22" Height="22" CornerRadius="5"
                                    Background="#1E1E1E" BorderBrush="#3A3A3A" BorderThickness="1.5">
                                <Path x:Name="CheckMark" Data="M 4,10 L 8,14 L 16,5"
                                      Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed" Margin="1,1,0,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#E8321A"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF5733"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#E8321A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.6"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Border Container with Shadow -->
    <Border CornerRadius="12" Background="#0D0D0D" BorderBrush="#262626" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="25" ShadowDepth="4" Opacity="0.85"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>   <!-- Title Bar -->
                <RowDefinition Height="84"/>   <!-- Header Banner -->
                <RowDefinition Height="*"/>    <!-- Component Checklist -->
                <RowDefinition Height="Auto"/> <!-- Bottom Panel / Progress / Completion -->
            </Grid.RowDefinitions>

            <!-- ── Custom Title Bar ─────────────────────────────── -->
            <Border Grid.Row="0" Background="#141414" CornerRadius="11,11,0,0"
                    BorderBrush="#202020" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚙" FontSize="18" Foreground="#E8321A" VerticalAlignment="Center"/>
                        <TextBlock Text=" MyGears" FontSize="14" FontWeight="Bold" Foreground="White"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <TextBlock Text=" — Cài Đặt Vào Máy Tính / Setup" FontSize="12" Foreground="#888"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>

                    <Button Content="✕" HorizontalAlignment="Right" Width="40" Height="40"
                            Background="Transparent" BorderThickness="0" Foreground="#888"
                            FontSize="14" Cursor="Hand" Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" Width="40" Height="40">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#C0392B"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- ── Header Banner ────────────────────────────────── -->
            <Border Grid.Row="1" Background="#111111" Padding="20,14" BorderBrush="#1C1C1C" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="52" Height="52" CornerRadius="10" Background="#1C1212"
                            BorderBrush="#E8321A" BorderThickness="1.5" Margin="0,0,16,0">
                        <TextBlock Text="🚀" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="CÀI ĐẶT &amp; CẬP NHẬT GEAR VÀO MÁY TÍNH"
                                   FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Hệ thống tự động phát hiện mọi driver trong USB. Hãy tick chọn những mục bạn muốn cài rồi bấm Tiếp tục:"
                                   FontSize="12" Foreground="#999" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Component Checklist (Center Scroll) ──────────── -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20,14">
                <ItemsControl ItemsSource="{Binding Components}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Background="#161616" BorderBrush="#252525" BorderThickness="1"
                                    Margin="0,0,0,10" Padding="14,12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#E8321A"/>
                                                <Setter Property="Background" Value="#1A1A1A"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- Checkbox -->
                                        <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                        <ColumnDefinition Width="*"/>    <!-- Info -->
                                        <ColumnDefinition Width="Auto"/> <!-- Status Badge -->
                                        <ColumnDefinition Width="Auto"/> <!-- Size -->
                                    </Grid.ColumnDefinitions>

                                    <!-- CheckBox -->
                                    <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0"
                                              Style="{StaticResource GamingCheckBoxStyle}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding IsRequired, Converter={StaticResource InvertBoolConverter}}"/>

                                    <!-- Icon container -->
                                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8"
                                            Background="#202020" BorderBrush="#303030" BorderThickness="1"
                                            Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Icon}" FontSize="20"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Name & Description -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="White"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11.5"
                                                   Foreground="#7A7A7A" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Status Badge -->
                                    <Border Grid.Column="3" CornerRadius="4" Padding="8,4" Margin="0,0,14,0"
                                            VerticalAlignment="Center" Background="#1C1C1C" BorderBrush="#2C2C2C" BorderThickness="1">
                                        <TextBlock Text="{Binding StatusBadge}" FontSize="11" FontWeight="Medium" Foreground="#00E676"/>
                                    </Border>

                                    <!-- Size Display -->
                                    <TextBlock Grid.Column="4" Text="{Binding SizeDisplay}" FontSize="13" FontWeight="Bold"
                                               Foreground="#00E5FF" VerticalAlignment="Center" HorizontalAlignment="Right"
                                               MinWidth="65" TextAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ── Bottom Panel ─────────────────────────────────── -->
            <Border Grid.Row="3" Background="#141414" CornerRadius="0,0,11,11"
                    BorderBrush="#202020" BorderThickness="0,1,0,0" Padding="20,16">
                <Grid>
                    <!-- Mode 1: Sẵn sàng cài đặt (Khi chưa bấm bắt đầu và chưa xong) -->
                    <StackPanel Visibility="{Binding IsInstalling, Converter={StaticResource InvertBoolToVisConverter}}">
                        <Grid Margin="0,0,0,12">
                            <!-- Quick action buttons -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Chỉ cài mục mới" Command="{Binding SelectOnlyNewCommand}"
                                        Style="{StaticResource ToolbarButtonStyle}" Padding="12,5" Margin="0,0,8,0"
                                        FontSize="11.5"/>
                                <Button Content="Chọn tất cả" Command="{Binding SelectAllCommand}"
                                        Style="{StaticResource ToolbarButtonStyle}" Padding="12,5" Margin="0,0,8,0"
                                        FontSize="11.5"/>
                                <Button Content="Bỏ chọn driver tùy chọn" Command="{Binding DeselectOptionalCommand}"
                                        Style="{StaticResource ToolbarButtonStyle}" Padding="12,5"
                                        FontSize="11.5"/>
                            </StackPanel>

                            <!-- Summary text -->
                            <TextBlock Text="{Binding SelectedSummaryText}"
                                       Foreground="#00E5FF" FontWeight="SemiBold" FontSize="12.5"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Big CTA Button -->
                        <Button Content="🚀 BẮT ĐẦU CÀI ĐẶT (ĐỂ RÚT USB)"
                                Command="{Binding StartInstallCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Height="44" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Mode 2: Đang cài đặt (Progress Bar) -->
                    <StackPanel Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisConverter}}">
                        <!-- Trong khi đang chạy và chưa xong -->
                        <StackPanel Visibility="{Binding IsCompleted, Converter={StaticResource InvertBoolToVisConverter}}">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{Binding ProgressStatusText}" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="{Binding InstallProgress, Converter={StaticResource DoubleToPctConverter}}"
                                           FontSize="13" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Right"/>
                            </Grid>

                            <ProgressBar Value="{Binding InstallProgress, Mode=OneWay}" Minimum="0" Maximum="1.0"
                                         Height="8" Margin="0,0,0,8"/>

                            <TextBlock Text="⚡ Đang sao chép tốc độ cao vào C:\Users\Public\MyGears… Vui lòng chờ vài giây."
                                       FontSize="11" Foreground="#888"/>
                        </StackPanel>

                        <!-- Khi đã hoàn tất thành công -->
                        <StackPanel Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisConverter}}">
                            <Border CornerRadius="8" Background="#0C2014" BorderBrush="#00E676" BorderThickness="1"
                                    Padding="16,12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🎉" FontSize="32" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="CÀI ĐẶT THÀNH CÔNG VÀO MÁY TÍNH!"
                                                   FontSize="14" FontWeight="Bold" Foreground="#00E676"/>
                                        <TextBlock Text="MyGears đang tự động khởi chạy từ máy tính. Bạn hãy RÚT USB RA và cắm Chuột / Bàn phím vào máy nhé!"
                                                   FontSize="12" Foreground="#C8E6C9" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Button Content="✅ ĐÃ HOÀN TẤT — ĐÓNG VÀ RÚT USB"
                                    Command="{Binding FinishAndExitCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Height="44" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
