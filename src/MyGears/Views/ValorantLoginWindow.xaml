<Window x:Class="MyGears.Views.ValorantLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:motion="clr-namespace:MyGears.Views" motion:CheckAccountMotion.Scope="True"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Đăng Nhập Riot Games - MyGears"
        Width="640" Height="780"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource AppFont}">

    <Border Background="{StaticResource BgDeep}"
            BorderBrush="{StaticResource BrassBezelGradient}"
            BorderThickness="1.5"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="4" Opacity="0.85"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Status / Instruction Bar -->
                <RowDefinition Height="*"/>    <!-- WebView2 Content -->
                <RowDefinition Height="Auto"/> <!-- Manual fallback footer -->
            </Grid.RowDefinitions>

            <!-- 1. Thanh tiêu đề kim loại cơ khí -->
            <Border Grid.Row="0" Background="{StaticResource ChassisRackGradient}"
                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1"
                    Padding="16,10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎯" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="ĐĂNG NHẬP RIOT GAMES" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <Border Background="#2B2012" BorderBrush="{StaticResource AccentBrass}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                            <TextBlock Text="XÁC THỰC SSO AN TOÀN" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentGold}" FontFamily="{StaticResource MonoFont}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="🚪 Đăng Xuất Riot (Đổi Nick)" Click="BtnLogoutRiot_Click"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Height="26" Padding="8,0" Margin="0,0,10,0" FontSize="10.5" Cursor="Hand"
                                ToolTip="Đăng xuất khỏi auth.riotgames.com/logout để nhập tài khoản mới"/>
                        <Button Content="✕"
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMuted}"
                                FontSize="14" Cursor="Hand" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Hướng dẫn, Đèn tín hiệu trạng thái & Nút Copy Nhanh -->
            <Border Grid.Row="1" Background="#0F131C" Padding="14,8" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="LampStatus" Width="8" Height="8" CornerRadius="4" Background="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatus" Text="Đang tải trang đăng nhập Riot Games chính thức..." FontSize="11.5" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>

                    <!-- Cụm nút Copy hỗ trợ người dùng dán vào form Riot -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="📋 Copy TK" Click="BtnCopyTk_Click" Style="{StaticResource ToolbarButtonStyle}"
                                Height="24" Padding="6,0" Margin="0,0,6,0" FontSize="10.5" Cursor="Hand" ToolTip="Sao chép tên tài khoản"/>
                        <Button Content="🔑 Copy MK" Click="BtnCopyMk_Click" Style="{StaticResource ToolbarButtonStyle}"
                                Height="24" Padding="6,0" Margin="0,0,6,0" FontSize="10.5" Cursor="Hand" ToolTip="Sao chép mật khẩu"/>
                        <Button Content="📝 Copy tk:mk" Click="BtnCopyCombo_Click" Style="{StaticResource ToolbarButtonStyle}"
                                Height="24" Padding="6,0" FontSize="10.5" Cursor="Hand" ToolTip="Sao chép định dạng tk:mk"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Trình duyệt WebView2 -->
            <Grid Grid.Row="2" Background="#080A0F">
                <wv2:WebView2 x:Name="Browser" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                <!-- Khung thông báo lỗi / Chưa cài WebView2 -->
                <Border x:Name="PanelWvError" Background="#12151B" Visibility="Collapsed" Padding="24">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                        <TextBlock Text="⚠️" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Không thể tải WebView2 hoặc đã có lỗi kết nối." FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="Bạn có thể mở trình duyệt ngoài, đăng nhập Riot Games và dán link redirect vào ô bên dưới."
                                   FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16"/>
                        <Button Content="Mở Link Bằng Trình Duyệt Ngoài (Chrome/Edge)" Click="BtnOpenExternalBrowser_Click"
                                Style="{StaticResource AccentButtonStyle}" Height="36" Padding="14,0" Cursor="Hand" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4. Footer Fallback nhập URL thủ công (phòng trường hợp trình duyệt không tự redirect) -->
            <Border Grid.Row="3" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Hoặc dán URL redirect:" Foreground="{StaticResource TextMuted}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="TxtManualUrl" Height="30" Background="#101319" Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource BorderCard}" CaretBrush="{StaticResource AccentGold}"
                             FontSize="11" FontFamily="{StaticResource MonoFont}" Padding="6,4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="Xác Nhận" Click="BtnConfirmManualUrl_Click"
                            Style="{StaticResource ToolbarButtonStyle}" Height="30" Padding="12,0" FontSize="11" Cursor="Hand"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
