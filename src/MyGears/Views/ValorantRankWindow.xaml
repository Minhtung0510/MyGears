<Window x:Class="MyGears.Views.ValorantRankWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:motion="clr-namespace:MyGears.Views" motion:CheckAccountMotion.Scope="True"
 Title="Lịch sử rank Valorant" Width="690" Height="620" MinWidth="550" MinHeight="400"
 WindowStartupLocation="CenterOwner" Background="#101217" Foreground="White">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock x:Name="TxtPlayer" FontSize="20" FontWeight="Bold"/>
   <TextBlock x:Name="TxtUpdated" Foreground="#94A3B8" Margin="0,5,0,16"/>
  </StackPanel>
  <Border Grid.Row="1" Background="#191E29" CornerRadius="8" Padding="16" Margin="0,0,0,14">
   <StackPanel>
    <TextBlock x:Name="TxtCurrent" Foreground="#5BCEFA" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/>
    <TextBlock x:Name="TxtSummary" Margin="0,8,0,0" TextWrapping="Wrap"/>
    <TextBlock x:Name="TxtNotice" Margin="0,8,0,0" Foreground="#F6C768" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
   <ItemsControl x:Name="ItemsHistory">
    <ItemsControl.ItemTemplate><DataTemplate>
     <Border motion:CheckAccountMotion.Card="True" BorderBrush="#344052" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8" Background="#151923">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Image Source="{Binding Icon}" Width="36" Height="36" Stretch="Uniform"/>
       <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="Bold"/><TextBlock Text="{Binding Detail}" Foreground="#94A3B8" Margin="0,5,0,0"/></StackPanel>
       <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Record}" Foreground="#31D5AD"/><ProgressBar Value="{Binding WinRate, Mode=OneWay}" Maximum="100" Height="4" Margin="0,8,0,0"/></StackPanel>
      </Grid>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
  <Button Grid.Row="3" Content="Đóng" IsCancel="True" HorizontalAlignment="Right" Padding="20,6" Margin="0,12,0,0"/>
 </Grid>
</Window>

