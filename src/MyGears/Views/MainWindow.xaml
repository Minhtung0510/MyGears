<Window x:Class="MyGears.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MyGears.ViewModels"
        Title="MyGears"
        Width="1360" Height="860"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D"
        BorderBrush="#E8321A" BorderThickness="1"
        WindowStyle="None"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>   <!-- Sidebar -->
            <ColumnDefinition Width="*"/>     <!-- Content -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>      <!-- Titlebar -->
            <RowDefinition Height="*"/>       <!-- Main area -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════
             TITLEBAR (spans both columns)
             ══════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <!-- Logo with accent glow -->
                    <Border Width="28" Height="28" CornerRadius="6" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E8321A" Offset="0"/>
                                <GradientStop Color="#FF6B2B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="⚙" FontSize="14" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="MyGears" FontSize="15" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text=" — Portable Gear Manager"
                               FontSize="11" Foreground="#555" VerticalAlignment="Center"
                               Margin="6,0,0,0"/>
                </StackPanel>

                <!-- Right: USB info + Deployment controls + window controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,4,0">

                    <!-- Khi đang chạy từ USB: Nút cài nhanh vào máy tính -->
                    <Button Command="{Binding DeployToPcCommand}"
                            Margin="0,0,10,0" Cursor="Hand"
                            ToolTip="Chép MyGears vào máy tính (mất ~1 giây) để bạn có thể rút USB ra cắm Chuột/Bàn phím">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunningFromUsb}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#E8321A" CornerRadius="5" Padding="10,5">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚡" FontSize="12" Margin="0,0,5,0" Foreground="White"/>
                                        <TextBlock Text="Cài vào máy (Rút USB)" FontWeight="SemiBold" FontSize="11" Foreground="White"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.88"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Khi đang chạy từ máy: Huy hiệu an toàn rút USB -->
                    <Border Background="#102A18" BorderBrush="#2ECC71" BorderThickness="1"
                            CornerRadius="5" Padding="8,4" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeployedLocally}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💻 Đang chạy trên máy tính" Foreground="#2ECC71" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text=" • Đã an toàn rút USB" Foreground="#A9DFBF" FontSize="11" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Khi đang chạy từ máy: Nút lưu cấu hình ngược về USB -->
                    <Button Command="{Binding SyncToUsbCommand}"
                            Margin="0,0,10,0" Cursor="Hand"
                            ToolTip="Cắm lại USB và bấm nút này để lưu cấu hình mới nhất trước khi về">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeployedLocally}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSyncingToUsb}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#1C1C1C" BorderBrush="#333" BorderThickness="1" CornerRadius="5" Padding="8,4">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="SyncIcon" Text="💾" FontSize="11" Margin="0,0,4,0"/>
                                        <TextBlock x:Name="SyncText" Text="Lưu về USB" FontSize="11" Foreground="#DDD"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2A2A2A"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsSyncingToUsb}" Value="True">
                                        <Setter TargetName="SyncIcon" Property="Text" Value="⚙"/>
                                        <Setter TargetName="SyncIcon" Property="Style" Value="{StaticResource SpinningStyle}"/>
                                        <Setter TargetName="SyncText" Property="Text" Value="Đang lưu…"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Khi đang chạy từ máy: Nút Tự Hủy & Dọn Sạch Dữ Liệu -->
                    <Button Command="{Binding SelfDestructCommand}"
                            Margin="0,0,10,0" Cursor="Hand"
                            ToolTip="Xóa sạch toàn bộ MyGears trên máy tính, xóa shortcut và dọn sạch clipboard không để lại dấu vết">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeployedLocally}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelfDestructing}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#2A1111" BorderBrush="#C0392B" BorderThickness="1" CornerRadius="5" Padding="8,4">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="SelfDestructIcon" Text="💣" FontSize="11" Margin="0,0,4,0"/>
                                        <TextBlock x:Name="SelfDestructText" Text="Tự Hủy Dọn Máy" FontSize="11" FontWeight="SemiBold" Foreground="#E74C3C"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#C0392B"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsSelfDestructing}" Value="True">
                                        <Setter TargetName="SelfDestructIcon" Property="Text" Value="⚙"/>
                                        <Setter TargetName="SelfDestructIcon" Property="Style" Value="{StaticResource SpinningStyle}"/>
                                        <Setter TargetName="SelfDestructText" Property="Text" Value="Đang dọn sạch…"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Border Background="#1A1A1A" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔌 Ổ: " Foreground="#555" FontSize="11"/>
                            <TextBlock Text="{Binding UsbRootDisplay}"
                                       Foreground="#888" FontSize="11" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>

                    <!-- Minimize -->
                    <Button Content="—" Width="40" Height="48"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#888" FontSize="12" Cursor="Hand"
                            Click="MinimizeButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="#888"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" Width="40" Height="48">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#252525"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Maximize -->
                    <Button Content="□" Width="40" Height="48"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#888" FontSize="12" Cursor="Hand"
                            Click="MaximizeButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="#888"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" Width="40" Height="48">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#252525"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Close -->
                    <Button Content="✕" Width="40" Height="48"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#888" FontSize="13" Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="#888"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" Width="40" Height="48">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#C0392B"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════
             SIDEBAR
             ══════════════════════════════════════════ -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
            <Grid x:Name="SidebarGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Thanh chỉ báo trượt mượt (Sliding Accent Bar) -->
                <Canvas Grid.Row="0" Width="3.5" HorizontalAlignment="Left" Margin="0,16,0,0" IsHitTestVisible="False">
                    <Border x:Name="SidebarAccentIndicator" Width="3.5" Height="44"
                            CornerRadius="0,3,3,0" Background="{StaticResource AccentGradient}">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF4D1A" BlurRadius="8" ShadowDepth="0" Opacity="0.85"/>
                        </Border.Effect>
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="AccentBarTransform" Y="0"/>
                        </Border.RenderTransform>
                    </Border>
                </Canvas>

                <!-- Module list -->
                <ItemsControl x:Name="SidebarItemsControl" Grid.Row="0" ItemsSource="{Binding Modules}"
                              Margin="8,16,8,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="ModuleBtn"
                                    Command="{Binding DataContext.SelectModuleCommand,
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Tag="{Binding}"
                                    IsEnabled="{Binding IsAvailable}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarItemStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                <Setter Property="Opacity" Value="0.4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="18"
                                               VerticalAlignment="Center" Width="28"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayNameVi}"
                                                   FontSize="13"/>
                                        <TextBlock Text="{Binding DisplayNameEn}"
                                                   FontSize="10" Foreground="#666"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Bottom: version info -->
                <StackPanel Grid.Row="1" Margin="16,8,16,16">
                    <Separator Background="{StaticResource BorderSubtle}" Margin="0,0,0,10"/>
                    <TextBlock Text="MyGears v1.0" Foreground="#444" FontSize="10"/>
                    <TextBlock Text="Portable • .NET 8 • WPF" Foreground="#333" FontSize="10"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════
             CONTENT AREA
             ══════════════════════════════════════════ -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource BgContent}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Banner thông báo -->
                    <RowDefinition Height="*"/>    <!-- Content host -->
                </Grid.RowDefinitions>

                <!-- Banner thông báo khi đã chạy trên máy tính -->
                <Border x:Name="BannerDeployedNotice" Grid.Row="0"
                        Background="#102A18" BorderBrush="#2ECC71" BorderThickness="0,0,0,1"
                        Padding="14,10" Visibility="Collapsed">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="BannerTransform" Y="0"/>
                    </Border.RenderTransform>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎉" FontSize="15" Margin="0,0,8,0"/>
                            <TextBlock Text="MyGears đã chạy hoàn toàn trên máy tính! " Foreground="#2ECC71" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Text="Bây giờ bạn hãy rút USB ra để cắm Chuột và Bàn phím vào nhé." Foreground="#D5F5E3" FontSize="13"/>
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0" Foreground="#AAA"
                                FontSize="12" Cursor="Hand" Click="DismissBanner_Click" Padding="6,2"/>
                    </Grid>
                </Border>

                <!-- Content host — filled programmatically from code-behind with smooth transition -->
                <ContentControl x:Name="ContentHost" Grid.Row="1"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                RenderTransformOrigin="0.5,0">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="ContentTransform" Y="0"/>
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════
             DEPLOYMENT LOADING OVERLAY
             ══════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2"
                Background="#EE0A0A0A" Panel.ZIndex="999">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDeploying}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="64" Height="64" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <Grid>
                        <TextBlock Text="⚙" FontSize="46" Foreground="{StaticResource AccentRed}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Style="{StaticResource SpinningStyle}"/>
                        <TextBlock Text="⚡" FontSize="22" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <TextBlock Text="Đang cài đặt MyGears vào máy tính…" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding DeployProgressText}" FontSize="14" Foreground="#2ECC71" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="Quá trình này chỉ mất ~1 giây. Sau khi hoàn tất bạn có thể rút USB ra ngay!" FontSize="12" Foreground="#888" HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
