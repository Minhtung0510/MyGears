<Window x:Class="MyGears.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MyGears.ViewModels"
        Title="MyGears — Vintage Mechanical Console MK-I"
        Width="1360" Height="860"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeep}"
        BorderBrush="{StaticResource AccentBrass}" BorderThickness="1.5"
        WindowStyle="None"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality"
        FontFamily="{StaticResource AppFont}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Mini Gauge Progress Bar for Hardware Telemetry (High-Contrast, Crisp & Solid) -->
        <Style x:Key="MiniGaugeBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Background" Value="#090C12"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Rectangle x:Name="PART_Indicator" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" RadiusX="4" RadiusY="4"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource ChassisRackGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>      <!-- Row 0: Titlebar & Engraved Nameplate -->
            <RowDefinition Height="106"/>     <!-- Row 1: Dedicated Analog Instrument & Gear Cluster Deck -->
            <RowDefinition Height="*"/>       <!-- Row 2: Switchboard (Col 0) + Content Bay (Col 1) -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════
             4 GÓC ỐC VÍT LỤC GIÁC ĐỒNG THAU (VINTAGE BRASS HEX BOLTS)
             ══════════════════════════════════════════════════════════════ -->
        <Control Grid.RowSpan="3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0" Panel.ZIndex="100"
                 Style="{StaticResource BrassScrewCapStyle}"/>
        <Control Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Panel.ZIndex="100"
                 Style="{StaticResource BrassScrewCapStyle}"/>
        <Control Grid.RowSpan="3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,6" Panel.ZIndex="100"
                 Style="{StaticResource BrassScrewCapStyle}"/>
        <Control Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6" Panel.ZIndex="100"
                 Style="{StaticResource BrassScrewCapStyle}"/>

        <!-- ══════════════════════════════════════════════════════════════
             ROW 0: TITLEBAR (Engraved Brass Machine Nameplate & Controls)
             ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSidebar}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <!-- Trái: Biển Tên Kim Loại Đồng Khắc Chìm (Engraved Brass Plate) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0,0,0">
                    <!-- Khung huy hiệu bánh răng đồng hoàng gia -->
                    <Border Width="34" Height="34" CornerRadius="8" Margin="0,0,10,0"
                            Background="{StaticResource PlateBevelGradient}"
                            BorderBrush="{StaticResource AccentBrass}" BorderThickness="1.2">
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource AccentAmberColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                        </Border.Effect>
                        <Grid>
                            <TextBlock x:Name="TitlebarGear" Text="⚙" FontSize="18" Foreground="{StaticResource AccentGold}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="TitlebarGearRotate" Angle="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Biển tên máy dập nổi -->
                    <Border Background="{StaticResource PlateBevelGradient}" CornerRadius="5" Padding="10,4"
                            BorderBrush="{StaticResource AccentBrass}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡ MYGEARS" FontSize="13.5" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <TextBlock Text=" • MECHANICAL WORKSTATION" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource AccentGold}" VerticalAlignment="Center"/>
                            <Border Background="#2B2012" CornerRadius="3" Padding="5,1" Margin="8,0,0,0"
                                    BorderBrush="{StaticResource AccentBrass}" BorderThickness="0.8">
                                <TextBlock Text="MK-I • SER. #2026" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrass}" FontFamily="{StaticResource MonoFont}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Phải: Các Công Tắc Khí Tài & Điều Khiển Cửa Sổ -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,8,0">

                    <!-- Khi đang chạy từ USB: Nút cài nhanh vào máy tính -->
                    <Button Command="{Binding DeployToPcCommand}"
                            Margin="0,0,10,0" Cursor="Hand"
                            ToolTip="Chép MyGears vào máy tính (mất ~1 giây) để bạn có thể rút USB ra cắm Chuột/Bàn phím">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunningFromUsb}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BdDeploy" Background="{StaticResource AccentGradient}" CornerRadius="6" Padding="12,6"
                                        BorderBrush="{StaticResource AccentGold}" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="{StaticResource AccentAmberColor}" BlurRadius="10" ShadowDepth="1" Opacity="0.6"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚡" FontSize="12" Margin="0,0,6,0" Foreground="#12100C"/>
                                        <TextBlock Text="Cài vào máy (Rút USB)" FontWeight="Bold" FontSize="11.5" Foreground="#12100C"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BdDeploy" Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Khi đang chạy từ máy: Huy hiệu ngọc an toàn rút USB -->
                    <Border Background="#10261C" BorderBrush="{StaticResource VintageEmerald}" BorderThickness="1"
                            CornerRadius="6" Padding="9,5" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeployedLocally}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="●" Foreground="{StaticResource VintageEmerald}" FontSize="10" Margin="0,0,5,0"
                                       Style="{StaticResource FilamentBreathingStyle}"/>
                            <TextBlock Text="MÁY TÍNH" Foreground="{StaticResource VintageEmerald}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text=" • AN TOÀN RÚT USB" Foreground="#A7F3D0" FontSize="10.5" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Cần gạt cơ học: Lưu về USB -->
                    <Button Command="{Binding SyncToUsbCommand}"
                            Margin="0,0,8,0" Cursor="Hand"
                            ToolTip="Cắm lại USB và bấm nút này để lưu cấu hình mới nhất trước khi về">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeployedLocally}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSyncingToUsb}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BdSync" Background="{StaticResource PlateBevelGradient}"
                                        BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="6" Padding="9,5">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="SyncIcon" Text="💾" FontSize="11" Margin="0,0,5,0"/>
                                        <TextBlock x:Name="SyncText" Text="Lưu về USB" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BdSync" Property="BorderBrush" Value="{StaticResource AccentBrass}"/>
                                        <Setter TargetName="SyncText" Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Công tắc giật bảo vệ: Tự Hủy Dọn Máy -->
                    <Button Command="{Binding SelfDestructCommand}"
                            Margin="0,0,10,0" Cursor="Hand"
                            ToolTip="Xóa sạch toàn bộ MyGears trên máy tính, xóa shortcut và dọn sạch clipboard không để lại dấu vết">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeployedLocally}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelfDestructing}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BdDestruct" Background="#261214" BorderBrush="{StaticResource VintageRuby}"
                                        BorderThickness="1.2" CornerRadius="6" Padding="9,5">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="SelfDestructIcon" Text="⚠️" FontSize="11" Margin="0,0,5,0"/>
                                        <TextBlock x:Name="SelfDestructText" Text="TỰ HỦY DỌN MÁY" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource VintageRuby}"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BdDestruct" Property="Background" Value="#3D181C"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- USB Drive indicator badge -->
                    <Border Background="{StaticResource PlateBevelGradient}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1"
                            CornerRadius="5" Padding="8,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔌 Ổ: " Foreground="{StaticResource TextMuted}" FontSize="11"/>
                            <TextBlock Text="{Binding UsbRootDisplay}"
                                       Foreground="{StaticResource AccentGold}" FontSize="11" FontFamily="{StaticResource MonoFont}"/>
                        </StackPanel>
                    </Border>

                    <!-- Minimize -->
                    <Button Content="—" Width="36" Height="42"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextSecondary}" FontSize="12" Cursor="Hand"
                            Click="MinimizeButton_Click"/>

                    <!-- Maximize -->
                    <Button Content="□" Width="36" Height="42"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextSecondary}" FontSize="12" Cursor="Hand"
                            Click="MaximizeButton_Click"/>

                    <!-- Close -->
                    <Button Content="✕" Width="36" Height="42"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextSecondary}" FontSize="13" Cursor="Hand"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             ROW 1: DEDICATED ANALOG INSTRUMENT & GEAR CLUSTER DECK
             (Băng Đồng Hồ Kim Cơ Khí & Cụm Bánh Răng Ăn Khớp Sống Động)
             ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="{StaticResource ChassisRackGradient}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid Margin="20,8,20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Instrument 1: Dual VU Needle Meters -->
                    <ColumnDefinition Width="Auto"/> <!-- Divider -->
                    <ColumnDefinition Width="Auto"/> <!-- Instrument 2: Interlocking Clockwork Gearbox -->
                    <ColumnDefinition Width="Auto"/> <!-- Divider -->
                    <ColumnDefinition Width="Auto"/> <!-- Instrument 3: Network Ping Meter -->
                    <ColumnDefinition Width="*"/>    <!-- Instrument 4: Hardware Telemetry Readout -->
                </Grid.ColumnDefinitions>

                <!-- ── 1. Cặp Đồng Hồ Kim Cơ Khí (Dual Analog VU Meters: CPU & RAM) ── -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- VU METER 1: CPU LOAD (%) -->
                    <Border Width="142" Height="88" Margin="0,0,8,0"
                            Background="{StaticResource DialFaceGradient}"
                            BorderBrush="{StaticResource BrassBezelGradient}" BorderThickness="1.5"
                            CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.7"/>
                        </Border.Effect>
                        <Grid ClipToBounds="True">
                            <Canvas IsHitTestVisible="False">
                                <!-- Background Track Arc (Crisp & High Contrast) -->
                                <Path Data="M 16,50 A 62,62 0 0 1 126,50" Stroke="#374151" StrokeThickness="3.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <!-- Active Amber Arc -->
                                <Path Data="M 16,50 A 62,62 0 0 1 100,38" Stroke="{StaticResource AccentAmber}" StrokeThickness="2.5" StrokeStartLineCap="Round"/>
                                <!-- Danger Warning Arc (80%-100%) -->
                                <Path Data="M 100,38 A 62,62 0 0 1 126,50" Stroke="{StaticResource VintageRuby}" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                <!-- Scale Tick Marks -->
                                <Line X1="22" Y1="42" X2="26" Y2="46" Stroke="#94A3B8" StrokeThickness="1.5"/>
                                <Line X1="71" Y1="14" X2="71" Y2="20" Stroke="#94A3B8" StrokeThickness="1.5"/>
                                <Line X1="120" Y1="42" X2="116" Y2="46" Stroke="{StaticResource VintageRuby}" StrokeThickness="1.5"/>

                                <!-- Scale Labels (Razor Sharp & High Contrast) -->
                                <TextBlock Text="0%" Canvas.Left="12" Canvas.Top="34" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" FontFamily="{StaticResource MonoFont}"/>
                                <TextBlock Text="50%" Canvas.Left="59" Canvas.Top="26" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" FontFamily="{StaticResource MonoFont}"/>
                                <TextBlock Text="100%" Canvas.Left="104" Canvas.Top="34" FontSize="9" FontWeight="Bold" Foreground="{StaticResource VintageRuby}" FontFamily="{StaticResource MonoFont}"/>

                                <!-- Digital Readout Capsule Bezel -->
                                <Border Canvas.Left="36" Canvas.Top="6" Width="70" Height="20"
                                        Background="#0A0D14" BorderBrush="{StaticResource AccentBrass}" BorderThickness="1" CornerRadius="4">
                                    <TextBlock Text="{Binding CurrentCpuLoad, StringFormat='{}{0:F0}%'}"
                                               FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource AccentGold}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"/>
                                </Border>

                                <!-- Bottom Meter Title Plaque -->
                                <Border Canvas.Left="16" Canvas.Top="67" Width="110">
                                    <TextBlock Text="CPU LOAD (%)" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource AccentGold}" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}"/>
                                </Border>
                            </Canvas>

                            <!-- Kim đồng hồ (Animated Needle 1 - CPU Load) -->
                            <Line x:Name="MeterNeedle1" X1="71" Y1="76" X2="71" Y2="16"
                                  Stroke="#FF4D4D" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Triangle"
                                  RenderTransformOrigin="0.5, 1.0">
                                <Line.RenderTransform>
                                    <RotateTransform x:Name="MeterNeedle1Rotate" Angle="-38"/>
                                </Line.RenderTransform>
                                <Line.Effect>
                                    <DropShadowEffect Color="#FF3333" BlurRadius="4" ShadowDepth="0" Opacity="0.8"/>
                                </Line.Effect>
                            </Line>

                            <Ellipse Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-4"
                                     Fill="{StaticResource BrushedBrassGradient}" Stroke="#443214" StrokeThickness="1.5"/>
                            <Ellipse Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                     Fill="#1E1E1E"/>
                        </Grid>
                    </Border>

                    <!-- VU METER 2: RAM USAGE (%) -->
                    <Border Width="142" Height="88"
                            Background="{StaticResource DialFaceGradient}"
                            BorderBrush="{StaticResource BrassBezelGradient}" BorderThickness="1.5"
                            CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.7"/>
                        </Border.Effect>
                        <Grid ClipToBounds="True">
                            <Canvas IsHitTestVisible="False">
                                <!-- Background Track Arc (Crisp & High Contrast) -->
                                <Path Data="M 16,50 A 62,62 0 0 1 126,50" Stroke="#374151" StrokeThickness="3.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <!-- Active Emerald Arc -->
                                <Path Data="M 16,50 A 62,62 0 0 1 126,50" Stroke="{StaticResource VintageEmerald}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                <!-- Scale Tick Marks -->
                                <Line X1="22" Y1="42" X2="26" Y2="46" Stroke="#94A3B8" StrokeThickness="1.5"/>
                                <Line X1="71" Y1="14" X2="71" Y2="20" Stroke="#94A3B8" StrokeThickness="1.5"/>
                                <Line X1="120" Y1="42" X2="116" Y2="46" Stroke="{StaticResource VintageEmerald}" StrokeThickness="1.5"/>

                                <!-- Scale Labels (Razor Sharp & High Contrast) -->
                                <TextBlock Text="0%" Canvas.Left="12" Canvas.Top="34" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" FontFamily="{StaticResource MonoFont}"/>
                                <TextBlock Text="50%" Canvas.Left="59" Canvas.Top="26" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" FontFamily="{StaticResource MonoFont}"/>
                                <TextBlock Text="100%" Canvas.Left="104" Canvas.Top="34" FontSize="9" FontWeight="Bold" Foreground="{StaticResource VintageEmerald}" FontFamily="{StaticResource MonoFont}"/>

                                <!-- Digital Readout Capsule Bezel -->
                                <Border Canvas.Left="36" Canvas.Top="6" Width="70" Height="20"
                                        Background="#0A0D14" BorderBrush="{StaticResource VintageEmerald}" BorderThickness="1" CornerRadius="4">
                                    <TextBlock Text="{Binding CurrentRamLoad, StringFormat='{}{0}%'}"
                                               FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource VintageEmerald}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"/>
                                </Border>

                                <!-- Bottom Meter Title Plaque -->
                                <Border Canvas.Left="16" Canvas.Top="67" Width="110">
                                    <TextBlock Text="RAM USAGE (%)" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource VintageEmerald}" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}"/>
                                </Border>
                            </Canvas>

                            <!-- Kim đồng hồ (Animated Needle 2 - RAM Usage) -->
                            <Line x:Name="MeterNeedle2" X1="71" Y1="76" X2="71" Y2="16"
                                  Stroke="#FFB703" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Triangle"
                                  RenderTransformOrigin="0.5, 1.0">
                                <Line.RenderTransform>
                                    <RotateTransform x:Name="MeterNeedle2Rotate" Angle="-10"/>
                                </Line.RenderTransform>
                                <Line.Effect>
                                    <DropShadowEffect Color="#FFA500" BlurRadius="4" ShadowDepth="0" Opacity="0.8"/>
                                </Line.Effect>
                            </Line>

                            <Ellipse Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-4"
                                     Fill="{StaticResource BrushedBrassGradient}" Stroke="#443214" StrokeThickness="1.5"/>
                            <Ellipse Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                     Fill="#1E1E1E"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Divider -->
                <Rectangle Grid.Column="1" Width="1.5" Height="76" Margin="14,0" Fill="{StaticResource BorderSubtle}"/>

                <!-- ── 2. Buồng 3 Bánh Răng Cơ Khí Răng Cưa Ăn Khớp (Clockwork Gearbox) ── -->
                <Border Grid.Column="2" Width="142" Height="88"
                        Background="#0B0E14" BorderBrush="{StaticResource BrassBezelGradient}" BorderThickness="1.5"
                        CornerRadius="8" Padding="4">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.7"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Khung kính nhìn thấu buồng bánh răng -->
                        <Canvas Grid.Row="0" Width="134" Height="60" ClipToBounds="True">
                            <!-- Bánh Răng Lớn 1 (Drive Gear) -->
                            <Grid Canvas.Left="10" Canvas.Top="4" Width="52" Height="52"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="GearTrain1Rotate" Angle="0"/>
                                </Grid.RenderTransform>
                                <Rectangle Width="10" Height="52" Fill="{StaticResource BrushedBrassGradient}" RadiusX="1.5" RadiusY="1.5"/>
                                <Rectangle Width="10" Height="52" Fill="{StaticResource BrushedBrassGradient}" RadiusX="1.5" RadiusY="1.5">
                                    <Rectangle.RenderTransform><RotateTransform Angle="30" CenterX="5" CenterY="26"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle Width="10" Height="52" Fill="{StaticResource BrushedBrassGradient}" RadiusX="1.5" RadiusY="1.5">
                                    <Rectangle.RenderTransform><RotateTransform Angle="60" CenterX="5" CenterY="26"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle Width="10" Height="52" Fill="{StaticResource BrushedBrassGradient}" RadiusX="1.5" RadiusY="1.5">
                                    <Rectangle.RenderTransform><RotateTransform Angle="90" CenterX="5" CenterY="26"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle Width="10" Height="52" Fill="{StaticResource BrushedBrassGradient}" RadiusX="1.5" RadiusY="1.5">
                                    <Rectangle.RenderTransform><RotateTransform Angle="120" CenterX="5" CenterY="26"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle Width="10" Height="52" Fill="{StaticResource BrushedBrassGradient}" RadiusX="1.5" RadiusY="1.5">
                                    <Rectangle.RenderTransform><RotateTransform Angle="150" CenterX="5" CenterY="26"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Ellipse Width="42" Height="42" Fill="{StaticResource PlateBevelGradient}" Stroke="{StaticResource AccentBrass}" StrokeThickness="1.5"/>
                                <Ellipse Width="26" Height="26" Fill="#12141A" Stroke="#66532B" StrokeThickness="1"/>
                                <Ellipse Width="12" Height="12" Fill="{StaticResource BrushedBrassGradient}"/>
                                <Ellipse Width="4" Height="4" Fill="#0E1013"/>
                            </Grid>

                            <!-- Bánh Răng Vừa 2 (Mated Gear, Quay Ngược Chiều) -->
                            <Grid Canvas.Left="56" Canvas.Top="14" Width="38" Height="38"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="GearTrain2Rotate" Angle="0"/>
                                </Grid.RenderTransform>
                                <Rectangle Width="8" Height="38" Fill="#B8860B" RadiusX="1" RadiusY="1"/>
                                <Rectangle Width="8" Height="38" Fill="#B8860B" RadiusX="1" RadiusY="1">
                                    <Rectangle.RenderTransform><RotateTransform Angle="45" CenterX="4" CenterY="19"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle Width="8" Height="38" Fill="#B8860B" RadiusX="1" RadiusY="1">
                                    <Rectangle.RenderTransform><RotateTransform Angle="90" CenterX="4" CenterY="19"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle Width="8" Height="38" Fill="#B8860B" RadiusX="1" RadiusY="1">
                                    <Rectangle.RenderTransform><RotateTransform Angle="135" CenterX="4" CenterY="19"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Ellipse Width="30" Height="30" Fill="{StaticResource PlateBevelGradient}" Stroke="#D4AF37" StrokeThickness="1.5"/>
                                <Ellipse Width="18" Height="18" Fill="#12141A"/>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource BrushedBrassGradient}"/>
                            </Grid>

                            <!-- Bánh Răng Nhỏ 3 (Pinion Gear) -->
                            <Grid Canvas.Left="90" Canvas.Top="6" Width="28" Height="28"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="GearTrain3Rotate" Angle="0"/>
                                </Grid.RenderTransform>
                                <Rectangle Width="6" Height="28" Fill="{StaticResource AccentGold}" RadiusX="1" RadiusY="1"/>
                                <Rectangle Width="6" Height="28" Fill="{StaticResource AccentGold}" RadiusX="1" RadiusY="1">
                                    <Rectangle.RenderTransform><RotateTransform Angle="60" CenterX="3" CenterY="14"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle Width="6" Height="28" Fill="{StaticResource AccentGold}" RadiusX="1" RadiusY="1">
                                    <Rectangle.RenderTransform><RotateTransform Angle="120" CenterX="3" CenterY="14"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Ellipse Width="22" Height="22" Fill="{StaticResource PlateBevelGradient}" Stroke="{StaticResource AccentGold}" StrokeThickness="1.2"/>
                                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentAmber}"/>
                            </Grid>
                        </Canvas>

                        <TextBlock Grid.Row="1" Text="CHRONO GEARBOX" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource AccentGold}" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}"/>
                    </Grid>
                </Border>

                <!-- Divider -->
                <Rectangle Grid.Column="3" Width="1.5" Height="76" Margin="14,0" Fill="{StaticResource BorderSubtle}"/>

                <!-- ── 3. Đồng Hồ Kim Đo Độ Trễ Mạng (VU Meter 3: Network Ping) ── -->
                <Border Grid.Column="4" Width="142" Height="88"
                        Background="{StaticResource DialFaceGradient}"
                        BorderBrush="{StaticResource BrassBezelGradient}" BorderThickness="1.5"
                        CornerRadius="8">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.7"/>
                    </Border.Effect>
                    <Grid ClipToBounds="True">
                        <Canvas IsHitTestVisible="False">
                            <!-- Background Track Arc (Crisp & High Contrast) -->
                            <Path Data="M 16,50 A 62,62 0 0 1 126,50" Stroke="#374151" StrokeThickness="3.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <!-- Active Cyan Arc -->
                            <Path Data="M 16,50 A 62,62 0 0 1 76,38" Stroke="#38BDF8" StrokeThickness="2.5" StrokeStartLineCap="Round"/>
                            <!-- Danger Ruby Arc -->
                            <Path Data="M 100,38 A 62,62 0 0 1 126,50" Stroke="{StaticResource VintageRuby}" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                            <!-- Scale Tick Marks -->
                            <Line X1="22" Y1="42" X2="26" Y2="46" Stroke="#94A3B8" StrokeThickness="1.5"/>
                            <Line X1="71" Y1="14" X2="71" Y2="20" Stroke="#94A3B8" StrokeThickness="1.5"/>
                            <Line X1="120" Y1="42" X2="116" Y2="46" Stroke="{StaticResource VintageRuby}" StrokeThickness="1.5"/>

                            <!-- Scale Labels (Razor Sharp & High Contrast) -->
                            <TextBlock Text="0ms" Canvas.Left="10" Canvas.Top="34" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" FontFamily="{StaticResource MonoFont}"/>
                            <TextBlock Text="50ms" Canvas.Left="57" Canvas.Top="26" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" FontFamily="{StaticResource MonoFont}"/>
                            <TextBlock Text="100ms+" Canvas.Left="98" Canvas.Top="34" FontSize="9" FontWeight="Bold" Foreground="{StaticResource VintageRuby}" FontFamily="{StaticResource MonoFont}"/>

                            <!-- Digital Readout Capsule Bezel -->
                            <Border Canvas.Left="36" Canvas.Top="6" Width="70" Height="20"
                                    Background="#0A0D14" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="4">
                                <TextBlock Text="{Binding NetPingText}"
                                           FontSize="12" FontWeight="Bold" Foreground="#38BDF8"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"/>
                            </Border>

                            <!-- Bottom Meter Title Plaque -->
                            <Border Canvas.Left="16" Canvas.Top="67" Width="110">
                                <TextBlock Text="PING LATENCY (ms)" FontSize="8.5" FontWeight="Bold"
                                           Foreground="#38BDF8" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}"/>
                            </Border>
                        </Canvas>

                        <!-- Kim đồng hồ (Animated Needle 3 - Ping Latency) -->
                        <Line x:Name="MeterNeedle3" X1="71" Y1="76" X2="71" Y2="16"
                              Stroke="#38BDF8" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Triangle"
                              RenderTransformOrigin="0.5, 1.0">
                            <Line.RenderTransform>
                                <RotateTransform x:Name="MeterNeedle3Rotate" Angle="-20"/>
                            </Line.RenderTransform>
                            <Line.Effect>
                                <DropShadowEffect Color="#0284C7" BlurRadius="4" ShadowDepth="0" Opacity="0.8"/>
                            </Line.Effect>
                        </Line>

                        <Ellipse Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-4"
                                 Fill="{StaticResource BrushedBrassGradient}" Stroke="#443214" StrokeThickness="1.5"/>
                        <Ellipse Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                 Fill="#1E1E1E"/>
                    </Grid>
                </Border>

                <!-- ── 4. Bảng Đo & Biểu Đồ Cấu Hình Máy Tính & Card (Hardware Telemetry Board - Razor Sharp) ── -->
                <Border Grid.Column="5" Margin="14,0,0,0"
                        Background="{StaticResource PlateBevelGradient}"
                        BorderBrush="{StaticResource AccentBrass}" BorderThickness="1.2"
                        CornerRadius="8" Padding="14,6">
                    <Grid VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Dòng 1: Vi Xử Lý CPU & Biểu đồ tiến trình -->
                        <Grid Grid.Row="0" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#2B2012" BorderBrush="{StaticResource AccentBrass}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,7,0">
                                    <TextBlock Text="CPU" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGold}" FontFamily="{StaticResource MonoFont}"/>
                                </Border>
                                <TextBlock Text="{Binding SpecsCpu}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="{StaticResource MonoFont}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SpecsCpu}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                <ProgressBar Style="{StaticResource MiniGaugeBarStyle}" Value="{Binding CurrentCpuLoad}" Maximum="100" Width="95"
                                             Foreground="{StaticResource AccentGold}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding CurrentCpuLoad, StringFormat='{}{0:F0}%'}" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource AccentGold}" FontFamily="{StaticResource MonoFont}" MinWidth="36" TextAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <!-- Dòng 2: Card Đồ Họa (GPU) To Rõ Nổi Bật -->
                        <Grid Grid.Row="1" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#2B2012" BorderBrush="{StaticResource AccentBrass}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,7,0">
                                    <TextBlock Text="GPU" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGold}" FontFamily="{StaticResource MonoFont}"/>
                                </Border>
                                <TextBlock Text="{Binding SpecsGpu}" FontSize="12" FontWeight="Bold" Foreground="#FCD34D" FontFamily="{StaticResource MonoFont}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SpecsGpu}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#064E3B" BorderBrush="{StaticResource VintageEmerald}" BorderThickness="1"
                                    CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="⚡ PCIe Active" FontSize="10" FontWeight="Bold" Foreground="#34D399" FontFamily="{StaticResource MonoFont}"/>
                            </Border>
                        </Grid>

                        <!-- Dòng 3: Bộ Nhớ RAM & Biểu đồ tiến trình -->
                        <Grid Grid.Row="2" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#0E281F" BorderBrush="{StaticResource VintageEmerald}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,7,0">
                                    <TextBlock Text="RAM" FontSize="10" FontWeight="Bold" Foreground="{StaticResource VintageEmerald}" FontFamily="{StaticResource MonoFont}"/>
                                </Border>
                                <TextBlock Text="{Binding RamDetailText}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="{StaticResource MonoFont}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                <ProgressBar Style="{StaticResource MiniGaugeBarStyle}" Value="{Binding CurrentRamLoad}" Maximum="100" Width="95"
                                             Foreground="{StaticResource VintageEmerald}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding CurrentRamLoad, StringFormat='{}{0}%'}" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource VintageEmerald}" FontFamily="{StaticResource MonoFont}" MinWidth="36" TextAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <!-- Dòng 4: Mạng Internet, Độ Trễ Ping & Tốc Độ Băng Thông -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#0C2538" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,7,0">
                                    <TextBlock Text="NET" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" FontFamily="{StaticResource MonoFont}"/>
                                </Border>
                                <TextBlock Text="{Binding NetAdapterText}" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" FontFamily="{StaticResource MonoFont}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                <Border Background="#0C2538" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NetPingText}" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" FontFamily="{StaticResource MonoFont}"/>
                                </Border>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#0C1B2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="{Binding NetSpeedText}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" FontFamily="{StaticResource MonoFont}"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             ROW 2: MAIN WORKSTATION BODY
             Col 0: Analog Mechanical Switchboard (Bảng Chọn Kênh Cơ Học)
             Col 1: Module Display Bay & Content Host (Khung Máy Hiển Thị)
             ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/> <!-- Tactical Mechanical Channel Selector -->
                <ColumnDefinition Width="*"/>   <!-- Module Display Content Host -->
            </Grid.ColumnDefinitions>

            <!-- ── COL 0: BẢNG CHỌN KÊNH CƠ HỌC (ANALOG SWITCHBOARD) ── -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgSidebar}"
                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
                <Grid x:Name="SidebarGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header Plaque -->
                        <RowDefinition Height="*"/>    <!-- Channel List -->
                        <RowDefinition Height="Auto"/> <!-- Bottom Inspection Plaque -->
                    </Grid.RowDefinitions>

                    <!-- Biển Bảng Điều Khiển Cơ Khí -->
                    <Border Grid.Row="0" Background="{StaticResource PlateBevelGradient}" BorderBrush="{StaticResource AccentBrass}" BorderThickness="1"
                            CornerRadius="6" Margin="12,12,12,6" Padding="10,6">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🎛️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ANALOG CHANNEL MATRIX" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentGold}" FontFamily="{StaticResource MonoFont}"/>
                                <TextBlock Text="BẢNG CHỌN KÊNH CƠ HỌC" FontSize="8" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Thanh chỉ báo trượt mượt kim loại đồng (Sliding Accent Indicator) -->
                    <Canvas Grid.Row="1" Width="4" HorizontalAlignment="Left" Margin="0,10,0,0" IsHitTestVisible="False">
                        <Border x:Name="SidebarAccentIndicator" Width="4" Height="50"
                                CornerRadius="0,3,3,0" Background="{StaticResource AccentGradient}">
                            <Border.Effect>
                                <DropShadowEffect Color="{StaticResource AccentAmberColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.85"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="AccentBarTransform" Y="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Canvas>

                    <!-- Danh sách các kênh cơ học -->
                    <ItemsControl x:Name="SidebarItemsControl" Grid.Row="1" ItemsSource="{Binding Modules}"
                                  Margin="10,8,10,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="ModuleBtn"
                                        Command="{Binding DataContext.SelectModuleCommand,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Tag="{Binding}"
                                        IsEnabled="{Binding IsAvailable}"
                                        Background="Transparent" BorderThickness="0" Margin="0,3" Padding="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="BdChannel" CornerRadius="8" Padding="10,9"
                                                    Background="{StaticResource PlateBevelGradient}"
                                                    BorderBrush="{StaticResource BorderCard}" BorderThickness="1.2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/> <!-- Đèn ngọc chỉ báo -->
                                                        <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                                        <ColumnDefinition Width="*"/>    <!-- Text tên kênh -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Đèn ngọc chỉ báo kênh (Jewel Lamp) -->
                                                    <Border x:Name="JewelLamp" Grid.Column="0" Width="10" Height="10" CornerRadius="5"
                                                            Background="#2B1A0D" BorderBrush="#553A18" BorderThickness="1"
                                                            VerticalAlignment="Center" Margin="2,0,10,0"/>

                                                    <!-- Icon -->
                                                    <TextBlock Grid.Column="1" Text="{Binding Icon}" FontSize="18"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                    <!-- Tên Kênh Vi / En -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock x:Name="TxtDisplayNameVi" Text="{Binding DisplayNameVi}"
                                                                   FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                                                        <TextBlock Text="{Binding DisplayNameEn}"
                                                                   FontSize="9.5" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BdChannel" Property="BorderBrush" Value="{StaticResource AccentBrass}"/>
                                                    <Setter TargetName="TxtDisplayNameVi" Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                    <Setter TargetName="BdChannel" Property="Opacity" Value="0.4"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Bottom: Thẻ Chứng Nhận Khí Tài Khắc Kim Loại -->
                    <Border Grid.Row="2" Background="{StaticResource PlateBevelGradient}"
                            BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                            CornerRadius="7" Margin="12,8,12,12" Padding="10,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="⚙" FontSize="11" Foreground="{StaticResource AccentGold}" Margin="0,0,5,0"
                                           Style="{StaticResource SlowGearSpinStyle}"/>
                                <TextBlock Text="MYGEARS CONSOLE" Foreground="{StaticResource TextPrimary}" FontSize="10.5" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="Mechanical Engine • v1.0" Foreground="{StaticResource AccentBrass}" FontSize="9"/>
                            <TextBlock Text="Portable • .NET 8 • Hardware Mode" Foreground="{StaticResource TextMuted}" FontSize="8.5" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ── COL 1: KHUNG MÁY HIỂN THỊ MODULE (CONTENT HOST) ── -->
            <Border Grid.Column="1" Background="{StaticResource BgContent}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Banner thông báo khi đã chạy trên máy -->
                        <RowDefinition Height="*"/>    <!-- Content host -->
                    </Grid.RowDefinitions>

                    <!-- Hình mờ Bánh Răng Cổ Điển Khổng Lồ trong nền -->
                    <Canvas Grid.RowSpan="2" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-80" Opacity="0.025">
                        <TextBlock Text="⚙" FontSize="420" Foreground="{StaticResource AccentBrass}"
                                   Style="{StaticResource SlowGearSpinStyle}"/>
                    </Canvas>

                    <!-- Banner thông báo khi đã chạy trên máy tính -->
                    <Border x:Name="BannerDeployedNotice" Grid.Row="0"
                            Background="#10261C" BorderBrush="{StaticResource VintageEmerald}" BorderThickness="0,0,0,1"
                            Padding="16,10" Visibility="Collapsed">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="BannerTransform" Y="0"/>
                        </Border.RenderTransform>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✨" FontSize="15" Margin="0,0,8,0"/>
                                <TextBlock Text="MyGears đã chạy hoàn toàn trên máy tính! " Foreground="{StaticResource VintageEmerald}" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="Bây giờ bạn hãy rút USB ra để cắm Chuột và Bàn phím vào nhé." Foreground="#D1FAE5" FontSize="13"/>
                            </StackPanel>
                            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondary}"
                                    FontSize="12" Cursor="Hand" Click="DismissBanner_Click" Padding="6,2"/>
                        </Grid>
                    </Border>

                    <!-- Content host: Nơi nạp UserControl của các Module -->
                    <ContentControl x:Name="ContentHost" Grid.Row="1"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    RenderTransformOrigin="0.5,0.5">
                        <ContentControl.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ContentScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                                <TranslateTransform x:Name="ContentTransform" Y="0"/>
                            </TransformGroup>
                        </ContentControl.RenderTransform>
                    </ContentControl>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             DEPLOYMENT LOADING OVERLAY
             ══════════════════════════════════════════════════════════════ -->
        <Border Grid.RowSpan="3"
                Background="#F20E1013" Panel.ZIndex="999">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDeploying}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="72" Height="72" Margin="0,0,0,20" HorizontalAlignment="Center"
                        Background="{StaticResource PlateBevelGradient}" CornerRadius="36"
                        BorderBrush="{StaticResource AccentBrass}" BorderThickness="1.5">
                    <Border.Effect>
                        <DropShadowEffect Color="{StaticResource AccentAmberColor}" BlurRadius="20" ShadowDepth="0" Opacity="0.7"/>
                    </Border.Effect>
                    <Grid>
                        <TextBlock Text="⚙" FontSize="46" Foreground="{StaticResource AccentGold}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Style="{StaticResource SpinningStyle}"/>
                        <TextBlock Text="⚡" FontSize="20" Foreground="{StaticResource TextPrimary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <TextBlock Text="Đang cài đặt MyGears vào máy tính…" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding DeployProgressText}" FontSize="14" Foreground="{StaticResource AccentGold}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="Quá trình này chỉ mất ~1 giây. Sau khi hoàn tất bạn có thể rút USB ra ngay!" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
