                      <StackPanel><TextBlock Text="RANK" Foreground="#94A3B8" FontSize="10"/><TextBlock x:Name="TxtInfoRank" Foreground="White" Margin="0,6" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel>
                      <StackPanel><TextBlock Text="VALORANT POINTS" Foreground="#94A3B8" FontSize="10"/><TextBlock x:Name="TxtInfoVp" Foreground="#FF4655" Margin="0,6" FontWeight="Bold"/></StackPanel>
