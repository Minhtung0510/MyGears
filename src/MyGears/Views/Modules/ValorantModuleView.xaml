                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border motion:CheckAccountMotion.Card="True" Background="{StaticResource PlateBevelGradient}" BorderBrush="{Binding Skin.TierColor}" BorderThickness="1.5"
                                        CornerRadius="10" Margin="6" Padding="14,12" MinHeight="190">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.75"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Badge Phẩm chất -->
                                        <Border Grid.Row="0" HorizontalAlignment="Right" Background="#1A1C24" BorderBrush="{Binding Skin.TierColor}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding Skin.TierName}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding Skin.TierColor}" FontFamily="{StaticResource MonoFont}"/>
                                        </Border>

                                        <!-- Hình ảnh súng render 3D -->
                                        <Viewbox Grid.Row="1" Height="95" Stretch="Uniform" Margin="0,8,0,8">
