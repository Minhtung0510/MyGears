                                                <TextBlock Text="{Binding TagText}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding BorderColor}" FontFamily="{StaticResource MonoFont}"/>
                                            </Border>

                                            <!-- Hình ảnh vật phẩm -->
                                            <Viewbox Grid.Row="1" Height="75" Stretch="Uniform" Margin="0,4">
                                                <Image Source="{Binding DisplayIcon}" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Viewbox>

                                            <!-- Tên Vật phẩm -->
                                            <TextBlock Grid.Row="2" Text="{Binding DisplayName}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>

                                            <!-- Loại & Giá VP -->
                                            <Grid Grid.Row="3">
                                                <TextBlock Text="{Binding CategoryName}" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding CostDisplay}" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentGold}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Footer thống kê -->
                <Border Grid.Row="3" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="18,8">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📊 Tổng cộng: " Foreground="{StaticResource TextMuted}" FontSize="11.5"/>
                            <TextBlock x:Name="TxtInvTotalCount" Text="0 Skins" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="11.5" Margin="0,0,16,0"/>
                            <TextBlock Text="💎 Tổng giá trị ước tính: " Foreground="{StaticResource TextMuted}" FontSize="11.5"/>
                            <TextBlock x:Name="TxtInvTotalValue" Text="0 VP" FontWeight="Bold" Foreground="{StaticResource AccentGold}" FontSize="11.5" FontFamily="{StaticResource MonoFont}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="ScanBusyOverlay" Grid.RowSpan="6" Panel.ZIndex="20" Background="#DD0B0E14" Visibility="Collapsed">
            <Border Background="#191E29" BorderBrush="#625439" BorderThickness="1" CornerRadius="16" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Ellipse Width="34" Height="34" Stroke="#F6C768" StrokeThickness="3" StrokeDashArray="7 3" RenderTransformOrigin="0.5,0.5" Margin="0,0,0,18"><Ellipse.RenderTransform><RotateTransform x:Name="ScanSpinnerTransform"/></Ellipse.RenderTransform></Ellipse>
                    <TextBlock Text="ĐANG QUÉT TÀI KHOẢN" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                    <TextBlock Text="Đang lấy kho đồ, rank, số dư và cửa hàng từ Riot…" Foreground="#A6ADBA" Margin="0,9,0,0" TextWrapping="Wrap" MaxWidth="340" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
        <!-- Khung ẩn để render ảnh PNG thẻ Inspector -->
        <Border x:Name="InspectorCardCanvas" Width="960" Height="540" Background="#0A0B12" Visibility="Collapsed"/>

        <!-- ══════════════════════════════════════════════════
             ROW 5: TOAST THÔNG BÁO TỰ ĐỘNG
             ══════════════════════════════════════════════════ -->
        <Border x:Name="ToastNotice" Grid.Row="5" Background="#10261C" BorderBrush="{StaticResource VintageEmerald}"
                BorderThickness="0,1,0,0" Padding="14,8" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="✅" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtToastMessage" Text="Thao tác hoàn tất!" FontSize="11.5" Foreground="{StaticResource VintageEmerald}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>


