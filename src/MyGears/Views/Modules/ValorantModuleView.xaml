                                                </Border>

                                                <Viewbox Grid.Row="1" Height="75" Stretch="Uniform" Margin="0,6">
                                                    <Image Source="{Binding Skin.DisplayIcon}" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Viewbox>
                                                <TextBlock Grid.Row="2" Text="{Binding Skin.DisplayName}" FontSize="12" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>

                                                <!-- Giá gốc & Giá giảm -->
                                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding OriginalCost, StringFormat='{}{0:N0}'}" FontSize="10.5" Foreground="{StaticResource TextMuted}" TextDecorations="Strikethrough" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding PriceText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource VintageEmerald}" FontFamily="{StaticResource MonoFont}"/>
