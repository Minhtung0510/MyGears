<UserControl x:Class="MyGears.Views.Modules.ValorantModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:motion="clr-namespace:MyGears.Views" motion:CheckAccountMotion.Scope="True"
             Background="{StaticResource BgDeep}"
             FontFamily="{StaticResource AppFont}">

    <UserControl.Resources>
        <Style x:Key="InfoCopyStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Background" Value="#1D1D20"/><Setter Property="Foreground" Value="#A0A0A8"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="12"><Path Data="M 8,5 L 8,2 L 18,2 L 18,14 L 15,14 M 3,6 L 13,6 L 13,18 L 3,18 Z" Width="15" Height="16" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#303036"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="InfoTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#A5A5AE"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Tab" Background="#161619" CornerRadius="14" Padding="23,13"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tab" Property="Background" Value="#00BA88"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Opacity" Value="0.85"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="ShopExtraTemplate">
            <Border motion:CheckAccountMotion.Card="True" Width="235" Margin="6" Padding="12" Background="#151923" BorderBrush="#394554" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{Binding Category}" Foreground="#94A3B8" FontSize="10"/>
                    <Grid Height="110" Margin="0,8"><Image Source="{Binding Icon}" Stretch="Uniform"/></Grid>
                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding PriceText}" Foreground="#EAB308" Margin="0,6"/>
                    <TextBlock Text="{Binding ExpiryText}" Foreground="#94A3B8" FontSize="10"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. Header Profile Card -->
            <RowDefinition Height="Auto"/> <!-- 1. Drawer nhập URL thủ công -->
            <RowDefinition Height="Auto"/> <!-- 2. Hàng Thống Kê Tổng Quan (Rank, Tier Pills, Mini Metrics) -->
            <RowDefinition Height="Auto"/> <!-- 3. Thanh Chọn 3 Tab (THÔNG TIN, CỬA HÀNG, KHO ĐỒ) -->
            <RowDefinition Height="*"/>    <!-- 4. Vùng Nội Dung Chính -->
            <RowDefinition Height="Auto"/> <!-- 5. Toast Thông Báo -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════
             ROW 0: PROFILE HEADER CARD (ĐẦY ĐỦ THÔNG TIN NHƯ NIGHTMARKET)
             ══════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtDataStatus" Grid.Row="1" Grid.ColumnSpan="2" TextWrapping="Wrap" FontSize="11" Foreground="#F6C768" Margin="0,8,0,0"/>
                <!-- Trái: Avatar Rank + Riot ID + Sub Meta -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Khung Avatar / Rank Icon -->
                    <Border Width="46" Height="46" CornerRadius="23" Background="#161824" BorderBrush="{StaticResource AccentBrass}" BorderThickness="1.5" Margin="0,0,12,0">
                        <Image x:Name="ImgProfileRankAvatar" Source="https://media.valorant-api.com/competitivetiers/5641173d-4437-3a4b-d246-dba494f43409/0/largeicon.png"
                               Width="34" Height="34" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <!-- Tên Riot ID & Subtitle -->
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtProfileRiotId" Text="Chưa Kết Nối" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimary}" Margin="0,0,8,0"/>
                            <Border x:Name="BadgeBanStatus" Background="#0E2818" BorderBrush="{StaticResource VintageEmerald}" BorderThickness="1" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtBadgeBanStatus" Text="🛡️ SẠCH" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource VintageEmerald}" FontFamily="{StaticResource MonoFont}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock x:Name="TxtProfileRegion" Text="REGION: AP (vnm)" FontSize="10.5" Foreground="{StaticResource TextMuted}" FontFamily="{StaticResource MonoFont}"/>
                            <TextBlock Text=" • " FontSize="10.5" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock x:Name="TxtProfileLastUpdated" Text="LẦN QUÉT: Chưa quét" FontSize="10.5" Foreground="{StaticResource TextMuted}" FontFamily="{StaticResource MonoFont}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Phải: Các Nút Thao Tác (Xóa Bản Quét, 1-Click Đăng Nhập, Dán Link) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="🗑️ XÓA BẢN QUÉT" Click="BtnClearScan_Click"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Height="34" Padding="12,0" Margin="0,0,8,0" FontSize="11" Cursor="Hand"
                            ToolTip="Đăng xuất / Xóa kết quả quét hiện tại"/>

                    <Button Content="🔑 Đăng Nhập Riot (1-Click)" Click="BtnOneClickLogin_Click"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Height="34" Padding="12,0" Margin="0,0,8,0" FontSize="11" Cursor="Hand"
                            ToolTip="Mở trang đăng nhập Riot Games chính thức và tự động bắt token"/>

                    <Button x:Name="BtnToggleManualDrawer" Content="📋 Dán Link" Click="BtnToggleManualDrawer_Click"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Height="34" Padding="12,0" FontSize="11" Cursor="Hand"
                            ToolTip="Nhập link redirect từ trang playvalorant.com/opt_in"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════
             ROW 1: NGĂN DÁN LINK THỦ CÔNG (COLLAPSIBLE)
             ══════════════════════════════════════════════════ -->
        <Border x:Name="DrawerManualInput" Grid.Row="1" Background="#10141E" BorderBrush="{StaticResource BorderCard}"
                BorderThickness="0,0,0,1" Padding="18,10" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Dán URL Redirect:" Foreground="{StaticResource AccentGold}" FontSize="12"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <TextBox Grid.Column="1" x:Name="TxtManualRedirectUrl" Height="34" Background="#0A0C12" Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource BorderCard}" CaretBrush="{StaticResource AccentGold}" FontSize="12"
                         FontFamily="{StaticResource MonoFont}" Padding="8,6" VerticalAlignment="Center" Margin="0,0,10,0"
                         ToolTip="Dán toàn bộ URL playvalorant.com/opt_in#access_token=..."/>

                <Button Grid.Column="2" Content="⚡ Quét Ngay" Click="BtnScanManualUrl_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        Height="34" Padding="16,0" FontSize="12" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════
             ROW 2: HÀNG THỐNG KÊ TỔNG QUAN (RANK, TIER PILLS, MINI METRICS)
             ══════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#0C0E16" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="18,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>    <!-- Box 1: RANK -->
                    <ColumnDefinition Width="1.2*"/>  <!-- Box 2: TIER SUMMARY -->
                    <ColumnDefinition Width="1.2*"/>  <!-- Box 3: MINI METRICS (LEVEL, VP, RP, KC) -->
                </Grid.ColumnDefinitions>

                <!-- Box 1: RANK BOX -->
                <Border Grid.Column="0" Background="#121520" BorderBrush="{StaticResource BorderCard}" BorderThickness="1"
                        CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="ImgOverviewRankIcon" Source="https://media.valorant-api.com/competitivetiers/5641173d-4437-3a4b-d246-dba494f43409/0/largeicon.png"
                               Width="36" Height="36" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <Button Content="RANK • XEM LỊCH SỬ ›" Click="BtnRankHistory_Click" HorizontalAlignment="Left" FontSize="10" Padding="4,2" Style="{StaticResource ToolbarButtonStyle}"/>
                            <TextBlock x:Name="TxtFullRankTitle" Text="Chưa có dữ liệu rank" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource MonoFont}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Box 2: TIER SUMMARY BOX -->
                <Border Grid.Column="1" Background="#121520" BorderBrush="{StaticResource BorderCard}" BorderThickness="1"
                        CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Đếm tổng skin -->
                        <TextBlock Grid.Column="0" x:Name="TxtTotalSkinsCount" Text="0 SKINS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,14,0"/>

                        <!-- Tier badges row -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <!-- Ultra -->
                            <Border Background="#25160A" BorderBrush="#F1A83B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" ToolTip="Ultra Edition">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔶 " FontSize="9" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtCountUltra" Text="0" FontSize="11" FontWeight="Bold" Foreground="#F1A83B" FontFamily="{StaticResource MonoFont}"/>
                                </StackPanel>
                            </Border>

                            <!-- Exclusive -->
                            <Border Background="#261E0A" BorderBrush="{StaticResource AccentGold}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" ToolTip="Exclusive Edition">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🟠 " FontSize="9" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtCountExclusive" Text="0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentGold}" FontFamily="{StaticResource MonoFont}"/>
                                </StackPanel>
                            </Border>

                            <!-- Premium -->
                            <Border Background="#220D1A" BorderBrush="#D1548D" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" ToolTip="Premium Edition">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🟣 " FontSize="9" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtCountPremium" Text="0" FontSize="11" FontWeight="Bold" Foreground="#D1548D" FontFamily="{StaticResource MonoFont}"/>
                                </StackPanel>
                            </Border>

                            <!-- Select -->
                            <Border Background="#0C2020" BorderBrush="#009587" BorderThickness="1" CornerRadius="4" Padding="6,2" ToolTip="Select / Deluxe Edition">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔵 " FontSize="9" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtCountSelect" Text="0" FontSize="11" FontWeight="Bold" Foreground="#009587" FontFamily="{StaticResource MonoFont}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Box 3: MINI METRIC (CHỈ SỐ LEVEL) -->
                <Border Grid.Column="2" Background="#121520" BorderBrush="{StaticResource BorderCard}" BorderThickness="1"
                        CornerRadius="8" Padding="18,8" VerticalAlignment="Center" MinWidth="95">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="CẤP ĐỘ" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtMetricLevel" Text="--" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentGold}" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════
             ROW 3: THANH CHỌN 3 TAB (THÔNG TIN, CỬA HÀNG, KHO ĐỒ)
             ══════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="#0A0A0D" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="18,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Tab 1: THÔNG TIN -->
                <RadioButton x:Name="TabRadioInfo" Content="🔒 THÔNG TIN"
                             IsChecked="True" Checked="TabRadio_Checked"
                             Style="{StaticResource InfoTabStyle}" Margin="0,0,10,0"/>

                <!-- Tab 2: CỬA HÀNG -->
                <RadioButton x:Name="TabRadioStore" Content="🏪 CỬA HÀNG"
                             Checked="TabRadio_Checked"
                             Style="{StaticResource InfoTabStyle}" Margin="0,0,10,0"/>

                <!-- Tab 3: KHO ĐỒ -->
                <RadioButton x:Name="TabRadioInventory" Content="🎒 KHO ĐỒ"
                             Checked="TabRadio_Checked"
                             Style="{StaticResource InfoTabStyle}"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════
             ROW 4: VÙNG NỘI DUNG CHÍNH (THEO TỪNG TAB)
             ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="4">
            <!-- ── EMPTY STATE: KHI CHƯA KẾT NỐI TÀI KHOẢN ── -->
            <Border x:Name="PanelEmptyState" Visibility="Visible" VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="600" Background="{StaticResource PlateBevelGradient}"
                    BorderBrush="{StaticResource AccentBrass}" BorderThickness="1.5" CornerRadius="12" Padding="36,32">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="4" Opacity="0.85"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="68" Height="68" CornerRadius="34" Background="#261E0A" BorderBrush="{StaticResource AccentGold}" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="🎯" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="CHƯA KẾT NỐI TÀI KHOẢN VALORANT" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentGold}"
                               HorizontalAlignment="Center" TextAlignment="Center" FontFamily="{StaticResource MonoFont}" Margin="0,0,0,8"/>

                    <TextBlock Text="Đăng nhập tài khoản Riot Games chính chủ để kiểm tra đầy đủ Thông tin tài khoản, Level, Rank, Ví VP/RP/KC, Cửa Hàng Hôm Nay và Kho Skin Sở Hữu."
                               FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="500" LineHeight="19" Margin="0,0,0,24"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Button Content="🔑 ĐĂNG NHẬP RIOT NGAY (1-CLICK)" Click="BtnOneClickLogin_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                Height="40" Padding="20,0" FontSize="12.5" FontWeight="Bold" Cursor="Hand" Margin="0,0,12,0"/>

                        <Button Content="📋 DÁN LINK THỦ CÔNG" Click="BtnToggleManualDrawer_Click"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Height="40" Padding="18,0" FontSize="12" Cursor="Hand"/>
                    </StackPanel>

                    <Border Background="#10141E" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="6" Padding="14,10" MaxWidth="500">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🛡️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Xác thực an toàn tuyệt đối qua Riot SSO chính thức. MyGears cam kết KHÔNG lưu trữ mật khẩu hay token của bạn."
                                       FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ── TAB 1: THÔNG TIN TÀI KHOẢN & SỐ DƯ VÍ ── -->
            <ScrollViewer x:Name="PanelInfoView" Background="#0A0A0D" VerticalScrollBarVisibility="Auto" Padding="22,22" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Path Data="M4,10 L20,10 L20,22 L4,22 Z M7,10 L7,6 A5,5 0 0 1 17,6 L17,10" Stroke="#00C995" StrokeThickness="1.8" Width="22" Height="24" Stretch="Uniform" Margin="0,0,12,0"/>
                        <TextBlock Text="PHÂN TÍCH BẢO MẬT &amp; ĐỊNH GIÁ" Foreground="White" FontWeight="ExtraBold" FontSize="22"/>
                    </StackPanel>
                    <UniformGrid Columns="2" Margin="0,0,-14,0">                        <Border motion:CheckAccountMotion.Card="True" Background="#101012" BorderBrush="#27272B" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,14,14" MinHeight="88">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="46" Height="46" CornerRadius="23" Background="#0B2029" VerticalAlignment="Center"><Path Data="M12,2 L20,6 L20,13 Q19,19 12,22 Q5,19 4,13 L4,6 Z M8,12 L11,15 L16,9" Stroke="#00BFF3" StrokeThickness="1.8" StrokeLineJoin="Round" Width="22" Height="22" Stretch="Uniform"/></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,10,0"><TextBlock Text="TÊN ĐĂNG NHẬP" Foreground="#797985" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="TxtInfoUsername" Text="Chưa có dữ liệu" TextWrapping="Wrap" Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,7,0,0"/></StackPanel>
                                <Button Grid.Column="2" Tag="TxtInfoUsername" Click="CopyInfo_Click" Style="{StaticResource InfoCopyStyle}" ToolTip="Sao chép" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border motion:CheckAccountMotion.Card="True" Background="#101012" BorderBrush="#27272B" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,14,14" MinHeight="88">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="46" Height="46" CornerRadius="23" Background="#101D2C" VerticalAlignment="Center"><Path Data="M12,2 A4,4 0 1 1 11.99,2 M4,22 L4,18 Q4,13 12,13 Q20,13 20,18 L20,22" Stroke="#479FFF" StrokeThickness="1.8" StrokeLineJoin="Round" Width="22" Height="22" Stretch="Uniform"/></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,10,0"><TextBlock Text="RIOT ID (IN-GAME)" Foreground="#797985" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="TxtInfoRiotId" Text="Chưa có dữ liệu" TextWrapping="Wrap" Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,7,0,0"/></StackPanel>
                                <Button Grid.Column="2" Tag="TxtInfoRiotId" Click="CopyInfo_Click" Style="{StaticResource InfoCopyStyle}" ToolTip="Sao chép" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border motion:CheckAccountMotion.Card="True" Background="#101012" BorderBrush="#27272B" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,14,14" MinHeight="88">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="46" Height="46" CornerRadius="23" Background="#09251D" VerticalAlignment="Center"><Path Data="M2,5 L22,5 L22,19 L2,19 Z M2,5 L12,13 L22,5" Stroke="#00D8A0" StrokeThickness="1.8" StrokeLineJoin="Round" Width="22" Height="22" Stretch="Uniform"/></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,10,0"><TextBlock Text="EMAIL" Foreground="#797985" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="TxtInfoEmail" Text="Chưa có dữ liệu" TextWrapping="Wrap" Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,7,0,0"/></StackPanel>
                                <Button Grid.Column="2" Tag="TxtInfoEmail" Click="CopyInfo_Click" Style="{StaticResource InfoCopyStyle}" ToolTip="Sao chép" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border motion:CheckAccountMotion.Card="True" Background="#101012" BorderBrush="#27272B" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,14,14" MinHeight="88">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="46" Height="46" CornerRadius="23" Background="#2A1020" VerticalAlignment="Center"><Path Data="M6,2 L18,2 L18,22 L6,22 Z M10,18 L14,18" Stroke="#F146AC" StrokeThickness="1.8" StrokeLineJoin="Round" Width="22" Height="22" Stretch="Uniform"/></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,10,0"><TextBlock Text="SĐT LIÊN KẾT" Foreground="#797985" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="TxtInfoPhone" Text="Chưa có dữ liệu" TextWrapping="Wrap" Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,7,0,0"/></StackPanel>
                                <Button Grid.Column="2" Tag="TxtInfoPhone" Click="CopyInfo_Click" Style="{StaticResource InfoCopyStyle}" ToolTip="Sao chép" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border motion:CheckAccountMotion.Card="True" Background="#101012" BorderBrush="#27272B" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,14,14" MinHeight="88">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="46" Height="46" CornerRadius="23" Background="#2D1217" VerticalAlignment="Center"><Path Data="M12,2 L20,6 L20,13 Q19,19 12,22 Q5,19 4,13 L4,6 Z M12,7 L12,13 M12,16 L12,18" Stroke="#FF4C60" StrokeThickness="1.8" StrokeLineJoin="Round" Width="22" Height="22" Stretch="Uniform"/></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,10,0"><TextBlock Text="TRẠNG THÁI CẤM" Foreground="#797985" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="TxtInfoBanStatus" Text="Chưa có dữ liệu" TextWrapping="Wrap" Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,7,0,0"/></StackPanel>
                                <Button Grid.Column="2" Tag="TxtInfoBanStatus" Click="CopyInfo_Click" Style="{StaticResource InfoCopyStyle}" ToolTip="Sao chép" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border motion:CheckAccountMotion.Card="True" Background="#101012" BorderBrush="#27272B" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,14,14" MinHeight="88">
