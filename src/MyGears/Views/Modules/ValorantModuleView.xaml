                                            <TextBlock Text="{Binding PriceText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource VintageEmerald}" FontFamily="{StaticResource MonoFont}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
