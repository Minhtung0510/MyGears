                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="LÀM MỚI SAU" FontSize="9.5" FontWeight="Bold" Foreground="#FF4655" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}"/>
