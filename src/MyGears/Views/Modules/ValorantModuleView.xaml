                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🏪 CỬA HÀNG HÀNG NGÀY // DAILY STORE" FontSize="13.5" FontWeight="Bold" Foreground="#FF4655"/>
                                <TextBlock Text="Skin và giá từ lần quét Riot gần nhất." FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                            </StackPanel>

