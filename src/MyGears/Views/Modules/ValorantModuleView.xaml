                      <StackPanel><TextBlock Text="KINGDOM CREDITS" Foreground="#94A3B8" FontSize="10"/><TextBlock x:Name="TxtInfoKc" Foreground="#A855F7" Margin="0,6" FontWeight="Bold"/></StackPanel>
