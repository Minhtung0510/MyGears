                            <Button Content="Phantom" Tag="Phantom" Click="FilterWeapon_Click" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,6,0" Padding="10,4" FontSize="11"/>
                            <Button Content="Cận Chiến" Tag="Cận chiến" Click="FilterWeapon_Click" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,6,0" Padding="10,4" FontSize="11"/>
