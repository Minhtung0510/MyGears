<UserControl x:Class="MyGears.Views.Modules.KeyboardModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource BgDeep}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⌨️  Bàn phím — Nano 68 (hub.fgg.com.cn)" Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                    <Border Background="#252525" CornerRadius="3" Padding="6,2" Margin="10,0,0,0">
                        <TextBlock x:Name="StatusBadge" Text="● Đang kết nối…"
                                   Foreground="#FFA500" FontSize="11"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnReload" Content="↺ Tải lại" Margin="6,0"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="BtnReload_Click"/>
                    <Button x:Name="BtnZoomIn" Content="🔍 +" Margin="3,0" Width="38"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="BtnZoomIn_Click"/>
                    <Button x:Name="BtnZoomOut" Content="🔍 −" Margin="3,0" Width="38"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="BtnZoomOut_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Khung thiết bị bo góc cho WebView2 (FGG Hub) -->
        <Border Grid.Row="1" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1"
                CornerRadius="8" Margin="12,10,12,12" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.4"/>
            </Border.Effect>
            <Grid>
                <!-- WebView2 chứa trang config bàn phím -->
                <wv2:WebView2 x:Name="WebView"/>

                <!-- Loading / Error overlay -->
                <Grid x:Name="LoadingOverlay" Background="{StaticResource BgSurface}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                        <!-- Loading Spinner xoay vô hạn quanh icon bàn phím -->
                        <Border Width="64" Height="64" Margin="0,0,0,16" HorizontalAlignment="Center">
                            <Grid>
                                <TextBlock Text="⚙" FontSize="44" Foreground="{StaticResource AccentRed}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Style="{StaticResource SpinningStyle}"/>
                                <TextBlock Text="⌨️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="LoadingTitle" Text="Đang tải cấu hình bàn phím Nano 68…"
                                   Foreground="{StaticResource TextPrimary}" FontSize="16" Margin="0,0,0,8"
                                   HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        <ProgressBar x:Name="LoadingProgressBar" IsIndeterminate="True"
                                     Height="4" Width="260" Margin="0,8" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="LoadingDetail" Text="Đang kết nối tới máy chủ hub.fgg.com.cn…"
                                   Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,8"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="LoadingTip" Text="💡 Máy chủ tại Trung Quốc nên lần tải đầu tiên có thể mất 10-20 giây. Dữ liệu sẽ tự động lưu offline cho những lần mở sau."
                                   Foreground="{StaticResource TextMuted}" FontSize="11" Margin="16,0,16,14"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="BtnRetry" Content="🔄 Thử tải lại" Visibility="Collapsed"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="BtnRetry_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
