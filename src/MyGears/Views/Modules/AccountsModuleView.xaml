<UserControl x:Class="MyGears.Views.Modules.AccountsModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MyGears.Views.Modules"
             xmlns:motion="clr-namespace:MyGears.Views" motion:CheckAccountMotion.Scope="True"
             Background="{StaticResource BgDeep}"
             FontFamily="{StaticResource AppFont}">

    <UserControl.Resources>
        <Style x:Key="AccountIconButton" TargetType="Button"><Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Foreground" Value="#AAAAAF"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Ring" Background="#19191C" BorderBrush="#303034" BorderThickness="1" CornerRadius="15"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Background" Value="#333338"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </UserControl.Resources>
    <Grid>
        <!-- ══════════════════════════════════════════════════
             MÀN HÌNH 1: KHÓA MÃ PIN (ANTIQUE BRASS SAFE VAULT)
             ══════════════════════════════════════════════════ -->
        <Border x:Name="PanelPinLocked" Background="{StaticResource BgDeep}" Visibility="Visible">
            <Grid>
                <!-- Decorative subtle gear watermark -->
                <Canvas IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.035">
                    <TextBlock Text="⚙" FontSize="420" Foreground="{StaticResource AccentBrass}"
                               Margin="-210,-210,0,0" Style="{StaticResource SlowGearSpinStyle}"/>
                </Canvas>

                <!-- Cửa Két Sắt Kim Loại Cổ Điển (Antique Vault Door Assembly) -->
                <Border Width="480" Background="{StaticResource ChassisRackGradient}"
                        BorderBrush="{StaticResource BrassBezelGradient}" BorderThickness="2"
                        CornerRadius="14" Padding="32,28" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.8"/>
                    </Border.Effect>
                    <Grid>
                        <!-- 4 Then chốt thép cơ học hai bên két sắt (Mechanical Vault Locking Bolts) -->
                        <Canvas IsHitTestVisible="False">
                            <Border Canvas.Left="-44" Canvas.Top="50" Width="24" Height="14" CornerRadius="2"
                                    Background="{StaticResource BrushedBrassGradient}" BorderBrush="#3A2A12" BorderThickness="1"/>
                            <Border Canvas.Left="-44" Canvas.Top="160" Width="24" Height="14" CornerRadius="2"
                                    Background="{StaticResource BrushedBrassGradient}" BorderBrush="#3A2A12" BorderThickness="1"/>
                            <Border Canvas.Right="-44" Canvas.Top="50" Width="24" Height="14" CornerRadius="2"
                                    Background="{StaticResource BrushedBrassGradient}" BorderBrush="#3A2A12" BorderThickness="1"/>
                            <Border Canvas.Right="-44" Canvas.Top="160" Width="24" Height="14" CornerRadius="2"
                                    Background="{StaticResource BrushedBrassGradient}" BorderBrush="#3A2A12" BorderThickness="1"/>
                        </Canvas>

                        <StackPanel HorizontalAlignment="Center" Width="380">
                            <!-- Vòng Xoay Mật Mã Tròn Trung Tâm (Rotary Combination Dial) -->
                            <Grid Width="120" Height="120" Margin="0,0,0,18" HorizontalAlignment="Center">
                                <!-- Vành số ngoài dập răng cưa (Knurled Dial Ring) -->
                                <Ellipse Width="120" Height="120" Fill="{StaticResource DialFaceGradient}"
                                         Stroke="{StaticResource BrassBezelGradient}" StrokeThickness="3"/>
                                <!-- Vạch chia độ mật mã -->
                                <Canvas Width="120" Height="120">
                                    <Path Data="M 15,60 A 45,45 0 1 1 105,60" Stroke="#7C6538" StrokeThickness="1.5"/>
                                    <TextBlock Text="0" Canvas.Left="56" Canvas.Top="12" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentGold}" FontFamily="{StaticResource MonoFont}"/>
                                    <TextBlock Text="25" Canvas.Left="94" Canvas.Top="52" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentGold}" FontFamily="{StaticResource MonoFont}"/>
                                    <TextBlock Text="50" Canvas.Left="53" Canvas.Top="94" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentGold}" FontFamily="{StaticResource MonoFont}"/>
                                    <TextBlock Text="75" Canvas.Left="14" Canvas.Top="52" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentGold}" FontFamily="{StaticResource MonoFont}"/>
                                </Canvas>
                                <!-- Trục tay quay 3 chấu (Crossed Wheel Spoke) -->
                                <Grid Style="{StaticResource SlowGearSpinStyle}">
                                    <Rectangle Width="80" Height="8" Fill="{StaticResource BrushedBrassGradient}" RadiusX="2" RadiusY="2"/>
                                    <Rectangle Width="8" Height="80" Fill="{StaticResource BrushedBrassGradient}" RadiusX="2" RadiusY="2"/>
                                </Grid>
                                <!-- Núm vặn trung tâm (Center Brass Hub) -->
                                <Border Width="40" Height="40" CornerRadius="20"
                                        Background="{StaticResource PlateBevelGradient}"
                                        BorderBrush="{StaticResource AccentBrass}" BorderThickness="1.5">
                                    <TextBlock Text="🔒" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="KHO MẬT MÃ CƠ HỌC • AES-256" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}"/>
                            <TextBlock Text="Cơ Chế Bảo Vệ Chống Chụp Trộm • Tự Xóa Clipboard Sau 25s" FontSize="11"
                                       Foreground="{StaticResource AccentGold}" HorizontalAlignment="Center" Margin="0,4,0,20"/>

                            <!-- Form Thiết Lập PIN Lần Đầu -->
                            <StackPanel x:Name="PanelSetupPin" Visibility="Collapsed">
                                <TextBlock Text="Thiết lập mã PIN cá nhân để bảo vệ tài khoản:"
                                           Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,8"/>
                                <PasswordBox x:Name="TxtNewPin" Height="42" Background="#12151B" Foreground="{StaticResource TextPrimary}"
                                             CaretBrush="{StaticResource AccentGold}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1"
                                             FontSize="16" Padding="10,8" HorizontalContentAlignment="Center"/>

                                <TextBlock Text="Nhập lại mã PIN xác nhận:"
                                           Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,14,0,8"/>
                                <PasswordBox x:Name="TxtConfirmPin" Height="42" Background="#12151B" Foreground="{StaticResource TextPrimary}"
                                             CaretBrush="{StaticResource AccentGold}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1"
                                             FontSize="16" Padding="10,8" HorizontalContentAlignment="Center"/>

                                <Button Content="Tạo Mã PIN &amp; Mở Khóa" Height="44" Margin="0,22,0,0"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Cursor="Hand" Click="BtnSetupPin_Click"/>
                            </StackPanel>

                            <!-- Form Nhập PIN Để Mở Khóa -->
                            <StackPanel x:Name="PanelEnterPin" Visibility="Visible" RenderTransformOrigin="0.5,0.5">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="PinShakeTransform" X="0"/>
                                </StackPanel.RenderTransform>
                                <TextBlock Text="Nhập mã PIN cá nhân để xoay chốt mở két sắt:"
                                           Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                                <PasswordBox x:Name="TxtUnlockPin" Height="46" Background="#0F1218" Foreground="{StaticResource TextPrimary}"
                                             CaretBrush="{StaticResource AccentGold}" BorderBrush="{StaticResource AccentBrass}" BorderThickness="1.2"
                                             FontSize="20" Padding="12,8" HorizontalContentAlignment="Center" KeyDown="TxtUnlockPin_KeyDown"/>

                                <Button Content="🔓 MỞ KHÓA KHO TÀI KHOẢN" Height="44" Margin="0,18,0,0"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Cursor="Hand" Click="BtnUnlock_Click"/>
                            </StackPanel>

                            <!-- Thông báo lỗi PIN -->
                            <TextBlock x:Name="LblPinError" Text="" Foreground="{StaticResource VintageRuby}" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════
             MÀN HÌNH 2: DANH SÁCH TÀI KHOẢN (UNLOCKED STATE)
             ══════════════════════════════════════════════════ -->
        <Grid x:Name="PanelAccountsList" Background="#0A0A0D" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Thanh công cụ & Badge bảo mật -->
                <RowDefinition Height="Auto"/> <!-- Thanh đếm ngược tự xóa clipboard -->
                <RowDefinition Height="Auto"/> <!-- Tìm skin toàn bộ tài khoản -->
                <RowDefinition Height="*"/>    <!-- Danh sách thẻ tài khoản -->
            </Grid.RowDefinitions>

            <!-- 1. Thanh Công Cụ & Trạng Thái Bảo Mật -->
            <Border Grid.Row="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="18,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Nút Thêm Tài Khoản -->
                        <Button Content="+ Thêm Tài Khoản Mới"
                                Style="{StaticResource AccentButtonStyle}"
                                Height="36" Padding="16,0" Margin="0,0,10,0"
                                FontSize="12" Cursor="Hand" Click="BtnAddAccount_Click"/>

                        <!-- Nút Nhập Hàng Loạt -->
                        <Button Content="📋 Nhập Hàng Loạt"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Height="36" Padding="14,0" Margin="0,0,12,0"
                                FontSize="12" Cursor="Hand" Click="BtnBulkImport_Click"
                                ToolTip="Dán danh sách nhiều tài khoản cùng lúc (định dạng user:pass mua từ shop/Discord bot)"/>

                        <!-- Nút Chuyển Đổi Bật/Tắt Chống Chụp Màn Hình -->
                        <Button x:Name="BtnToggleAntiCapture" Click="BtnToggleAntiCapture_Click"
                                Background="{StaticResource PlateBevelGradient}" BorderBrush="{StaticResource AccentBrass}" BorderThickness="1"
                                Cursor="Hand" VerticalAlignment="Center" Padding="10,6"
                                ToolTip="Bấm để chuyển đổi Bật/Tắt chế độ chống chụp trộm màn hình">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtAntiCaptureIcon" Text="📷" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtAntiCaptureStatus" Text="Chống Chụp: TẮT (Cho phép chụp)" Foreground="{StaticResource AccentGold}" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Nút Khóa Ngay -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="🔒 Khóa Kho"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="12,6" FontSize="11.5" Cursor="Hand" Click="BtnLockVault_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Thanh Thông Báo & Đếm Ngược Xóa Clipboard -->
            <Border x:Name="ToastClipboardWipe" Grid.Row="1" Background="#10261C" BorderBrush="{StaticResource VintageEmerald}"
                    BorderThickness="0,0,0,1" Padding="16,10" Visibility="Collapsed">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✅" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtClipboardNotice"
                                   Text="Đã copy theo định dạng tk:mk! Bộ nhớ tạm sẽ tự động xóa sau 25 giây để bảo mật."
                                   Foreground="#A7F3D0" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondary}"
                            FontSize="11" Cursor="Hand" Click="DismissToast_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Margin="18,12,18,0">
                <TextBlock Text="TÌM SKIN TRÊN TOÀN BỘ TÀI KHOẢN" Foreground="#F6C768" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Xóa tìm kiếm" Click="ClearSkinSearch_Click" Style="{StaticResource ToolbarButtonStyle}" Margin="8,0,0,0"/>
                    <TextBox x:Name="TxtSkinSearch" TextChanged="SkinSearch_Changed" Height="34" Background="#161B24" Foreground="White" CaretBrush="White" BorderBrush="#485064" Padding="10,6" ToolTip="Nhập tên skin hoặc loại súng, ví dụ Prime Vandal. Chỉ tìm trong kho đã lưu, không tìm cửa hàng."/>
                </DockPanel>
                <TextBlock x:Name="TxtSkinSearchStatus" Foreground="#A6ADBA" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
            <!-- 3. Danh Sách Thẻ Tài Khoản -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="18">
                <StackPanel>
                    <!-- Danh sách hiển thị -->
                    <ItemsControl x:Name="AccountsItemsControl">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource AccountCardMotion}" Loaded="AccountCard_Loaded" MouseEnter="AccountCard_MouseEnter" MouseLeave="AccountCard_MouseLeave" PreviewMouseLeftButtonDown="AccountCard_Press" PreviewMouseLeftButtonUp="AccountCard_Release" ToolTip="{Binding ValorantData.DataStatusText}" Width="282" Background="#101012" BorderThickness="1" CornerRadius="22" Padding="19" Margin="0,0,20,22" Tag="{Binding}" MouseLeftButtonUp="AccountCard_MouseLeftButtonUp" Cursor="Hand">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="54"/><RowDefinition Height="50"/><RowDefinition Height="64"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                        <Border Background="#09090B" BorderBrush="#252528" BorderThickness="1" CornerRadius="16" Width="60" Height="64" VerticalAlignment="Top">
                                            <Grid><TextBlock Text="V" Foreground="#00BE91" FontSize="29" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,2,0,16"/><Image Source="{Binding CardRankIcon}" Width="33" Height="33" VerticalAlignment="Top" Margin="0,8,0,0"/><TextBlock Text="{Binding CardLevel}" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5"/></Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,7,0">
                                            <TextBlock Text="{Binding CardName}" Foreground="White" FontWeight="ExtraBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding CardName}"/>
                                            <TextBlock Text="{Binding CardTag}" Foreground="#77777F" FontSize="11" Margin="0,3,0,7" TextTrimming="CharacterEllipsis"/>
                                            <Border Background="#09090B" BorderBrush="#29292D" BorderThickness="1" CornerRadius="9" Padding="7,3" HorizontalAlignment="Left"><TextBlock Text="{Binding CardRank}" Foreground="White" FontSize="9" FontWeight="Bold"/></Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Button Content="⋯" Tag="{Binding}" Click="AccountMenu_Click" ToolTip="Thao tác tài khoản" Style="{StaticResource AccountIconButton}"/>
                                            <Button Tag="{Binding}" Click="BtnDeleteAccount_Click" ToolTip="Xóa tài khoản" Style="{StaticResource AccountIconButton}" Margin="0,7,0,0"><Path Data="M3,6 L21,6 M8,6 L8,3 L16,3 L16,6 M6,6 L7,21 L17,21 L18,6 M10,9 L10,18 M14,9 L14,18" Stroke="#AAAAAF" StrokeThickness="1.4" Width="13" Height="15" Stretch="Uniform"/></Button>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,10,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border Background="#09090B" BorderBrush="#1D1D20" BorderThickness="1" CornerRadius="14"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="VP" Foreground="#A5AEAB" Margin="0,0,8,0"/><TextBlock Text="{Binding CardVp}" Foreground="White" FontWeight="Bold" FontSize="14"/></StackPanel></Border>
                                        <Border Grid.Column="2" Background="#09090B" BorderBrush="#1D1D20" BorderThickness="1" CornerRadius="14"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="RP" Foreground="#A5AEAB" Margin="0,0,8,0"/><TextBlock Text="{Binding CardRp}" Foreground="White" FontWeight="Bold" FontSize="14"/></StackPanel></Border>
                                    </Grid>
                                    <Border Grid.Row="2" Background="#131315" BorderBrush="#2B2B2E" BorderThickness="1" CornerRadius="20" Margin="0,8,0,4" Padding="6,4">
                                        <StackPanel Orientation="Horizontal"><Border Background="#27272A" CornerRadius="14" Padding="8,2"><StackPanel Orientation="Horizontal"><TextBlock Text="▲ " Foreground="#FF4655"/><TextBlock Text="{Binding CardSkins}" Foreground="White" FontWeight="Bold"/></StackPanel></Border><Border Background="#291320" CornerRadius="10" Padding="7,2" Margin="6,0,0,0"><TextBlock Text="{Binding CardPremium}" Foreground="#D1548D" FontSize="11"/></Border><Border Background="#08272A" CornerRadius="10" Padding="7,2" Margin="5,0,0,0"><TextBlock Text="{Binding CardOther}" Foreground="#00BEBB" FontSize="11"/></Border></StackPanel>
                                    </Border>
                                    <Border Grid.Row="3" BorderBrush="#222225" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,13,0,0">
                                        <Grid><Border Background="#28282B" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding CardCountry}" Foreground="White" FontSize="10" FontWeight="Bold"/></Border><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="CẬP NHẬT LÚC" Foreground="#77777F" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock Text="{Binding CardUpdated}" Foreground="#C3C3CB" FontSize="10" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Grid>
                                    </Border>
                                    <StackPanel Grid.Row="4">
                                    <TextBlock Text="{Binding CardMatchedSkins}" Foreground="#00DCA1" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding CardEmail}" ToolTip="{Binding CardEmail}" Foreground="#A6ADBA" TextTrimming="CharacterEllipsis" FontSize="10" Margin="0,6,0,0"/>
                                    <Button Content="{Binding ValorantInspectButtonText}" Tag="{Binding}" Click="BtnInspectValorant_Click" Style="{StaticResource ToolbarButtonStyle}" Padding="8,5" Margin="0,10,0,0" FontSize="10" ToolTip="{Binding ValorantInspectButtonToolTip}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Thông báo khi trống danh sách: Hộc Két Sắt Mật Mã Cổ Điển -->
                    <Border x:Name="PanelEmptyAccounts" Background="{StaticResource ChassisRackGradient}"
                            BorderBrush="{StaticResource BrassBezelGradient}" BorderThickness="1.5"
                            CornerRadius="12" Padding="40,32" Margin="20,30,20,0" Visibility="Collapsed" HorizontalAlignment="Center" MaxWidth="540">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity="0.75"/>
                        </Border.Effect>
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Ổ Khóa Đồng Thau Cổ Điển -->
                            <Border Width="68" Height="68" CornerRadius="34" Margin="0,0,0,16" HorizontalAlignment="Center"
                                    Background="{StaticResource PlateBevelGradient}"
                                    BorderBrush="{StaticResource AccentBrass}" BorderThickness="1.5">
                                <Border.Effect>
                                    <DropShadowEffect Color="{StaticResource AccentAmberColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.6"/>
                                </Border.Effect>
                                <TextBlock Text="🗝️" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="KHO HỘC KÉT SẮT CHƯA CÓ DỮ LIỆU" Foreground="{StaticResource AccentGold}" FontSize="14.5" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}"/>
                            <TextBlock Text="Các tài khoản game (Steam, Valorant, Riot...) được mã hóa AES-256 an toàn và tự xóa bộ nhớ tạm sau khi copy."
                                       Foreground="{StaticResource TextSecondary}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,20"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="➕ THÊM TÀI KHOẢN ĐẦU TIÊN" Click="BtnAddAccount_Click"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Height="42" Padding="20,0" Margin="0,0,10,0" FontSize="12" Cursor="Hand"/>

                                <Button Content="📋 NHẬP HÀNG LOẠT (DISCORD/BOT)" Click="BtnBulkImport_Click"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Height="42" Padding="18,0" FontSize="12" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ══════════════════════════════════════════════════
             MÀN HÌNH 3: XEM CHI TIẾT SOI VALORANT CỦA TÀI KHOẢN
             ══════════════════════════════════════════════════ -->
        <Grid x:Name="PanelValorantInspector" motion:CheckAccountMotion.Scope="True" Visibility="Collapsed" Background="{StaticResource BgDeep}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Thanh Top Bar điều hướng -->
                <RowDefinition Height="*"/>    <!-- Component ValorantModuleView -->
            </Grid.RowDefinitions>

            <!-- Top Bar Điều Hướng & Thao Tác -->
            <Border Grid.Row="0" Background="#0C0E17" BorderBrush="{StaticResource BorderCard}" BorderThickness="0,0,0,1" Padding="18,10">
                <Grid>
                    <!-- Trái: Nút quay lại & Tên tài khoản -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="← QUAY LẠI DANH SÁCH" Click="BtnBackToAccounts_Click"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Height="36" Padding="16,0" FontSize="11.5" FontWeight="Bold" Margin="0,0,16,0" Cursor="Hand"/>

                        <Border Background="#201812" BorderBrush="{StaticResource AccentGold}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,12,0">
                            <TextBlock Text="VALORANT" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentGold}"/>
                        </Border>

                        <TextBlock x:Name="TxtInspectorAccountLabel" Text="Tài khoản" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtInspectorAccountCombo" Text="[tk:mk]" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="{StaticResource MonoFont}"/>
                    </StackPanel>

                    <!-- Phải: Nút Copy tk:mk & Quét Lại Token Mới -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="📋 Copy tk:mk" Click="BtnInspectorCopyCombo_Click"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Height="36" Padding="14,0" Margin="0,0,10,0" FontSize="11" Cursor="Hand"
                                ToolTip="Sao chép tk:mk vào Clipboard"/>

                        <Button Content="🔄 LẤY LẠI TOKEN MỚI (QUÉT LẠI)" Click="BtnInspectorRescan_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                Height="36" Padding="16,0" FontSize="11.5" FontWeight="Bold" Cursor="Hand"
                                ToolTip="Mở Riot đăng nhập lại và cập nhật toàn bộ dữ liệu mới nhất"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Valorant Module View Component -->
            <local:ValorantModuleView Grid.Row="1" x:Name="ValInspectorControl"/>
        </Grid>

        <!-- ══════════════════════════════════════════════════
             MODAL: THÊM / SỬA TÀI KHOẢN (DIALOG OVERLAY)
             ══════════════════════════════════════════════════ -->
        <Border x:Name="ModalAccountEditor" Background="#E60A0D12" Panel.ZIndex="100" Visibility="Collapsed">
            <Border Width="440" Background="{StaticResource BgDeep}" BorderBrush="{StaticResource AccentBrass}" BorderThickness="1.2"
                    CornerRadius="10" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.85"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="TxtModalTitle" Text="Thêm Tài Khoản Mới" FontSize="16"
                               FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

                    <!-- Chọn Game / Nền Tảng -->
                    <TextBlock Text="Chọn Game / Nền tảng:" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,14">
                        <!-- Chip Valorant -->
                        <Button x:Name="ChipValorant" Tag="Valorant" Click="ChipGame_Click" Margin="0,0,8,8" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#281A10" BorderBrush="{StaticResource AccentBrass}" BorderThickness="1.5" CornerRadius="6" Padding="12,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔴" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Valorant" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Chip Steam / CS2 -->
                        <Button x:Name="ChipSteam" Tag="Steam (CS2)" Click="ChipGame_Click" Margin="0,0,8,8" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{StaticResource PlateBevelGradient}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="6" Padding="12,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔵" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Steam / CS2" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Chip Riot Games -->
                        <Button x:Name="ChipRiot" Tag="Riot Games" Click="ChipGame_Click" Margin="0,0,8,8" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{StaticResource PlateBevelGradient}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="6" Padding="12,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔺" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Riot Games (LMHT)" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Chip Epic Games -->
                        <Button x:Name="ChipEpic" Tag="Epic Games" Click="ChipGame_Click" Margin="0,0,8,8" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{StaticResource PlateBevelGradient}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="6" Padding="12,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Epic Games" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Chip Khác -->
                        <Button x:Name="ChipOther" Tag="Khác" Click="ChipGame_Click" Margin="0,0,8,8" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{StaticResource PlateBevelGradient}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="6" Padding="12,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🟣" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Khác..." Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </WrapPanel>

                    <!-- Tên Gợi Nhớ -->
                    <TextBlock Text="Tên gợi nhớ (VD: Acc Main Full Skin, Acc Smurf):" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtEditLabel" Height="38" Background="#12151B" Foreground="{StaticResource TextPrimary}"
                             CaretBrush="{StaticResource AccentGold}" BorderBrush="{StaticResource BorderCard}" FontSize="13" Padding="10,8" Margin="0,0,0,14"/>

                    <!-- Tài Khoản (Username) -->
                    <TextBlock Text="Tên đăng nhập (Username):" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtEditUsername" Height="38" Background="#12151B" Foreground="{StaticResource TextPrimary}"
                             CaretBrush="{StaticResource AccentGold}" BorderBrush="{StaticResource BorderCard}" FontSize="13" Padding="10,8" Margin="0,0,0,14"/>

                    <!-- Mật Khẩu -->
                    <TextBlock Text="Mật khẩu (Password):" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtEditPassword" Height="38" Background="#12151B" Foreground="{StaticResource TextPrimary}"
                             CaretBrush="{StaticResource AccentGold}" BorderBrush="{StaticResource BorderCard}" FontSize="13" Padding="10,8" Margin="0,0,0,22"/>

                    <!-- Nút Lưu & Hủy -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Hủy" Height="40"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Cursor="Hand" Click="BtnCancelEdit_Click"/>

                        <Button Grid.Column="2" Content="💾 Lưu Tài Khoản" Height="40"
                                Style="{StaticResource AccentButtonStyle}"
                                Cursor="Hand" Click="BtnSaveAccount_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- ══════════════════════════════════════════════════
             MODAL 2: NHẬP HÀNG LOẠT & GHI CHÚ TỪNG TÀI KHOẢN
             ══════════════════════════════════════════════════ -->
        <Border x:Name="ModalBulkImport" Grid.RowSpan="2" Background="#D005080E" Visibility="Collapsed">
            <Border Width="760" MaxHeight="680" Background="{StaticResource BgSurface}"
                    BorderBrush="{StaticResource AccentBrass}" BorderThickness="1.2"
                    CornerRadius="10" Padding="22,18" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="#000000" Opacity="0.85"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Chips & Tips -->
                        <RowDefinition Height="Auto"/> <!-- Raw Input -->
                        <RowDefinition Height="Auto"/> <!-- Preview summary & Quick tool -->
                        <RowDefinition Height="*"/>    <!-- Scrollable Table -->
                        <RowDefinition Height="Auto"/> <!-- Footer Actions -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📋" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Nhập Hàng Loạt &amp; Ghi Chú Từng Tài Khoản" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMuted}"
                                FontSize="14" Cursor="Hand" Click="BtnCancelBulkImport_Click"/>
                    </Grid>

                    <!-- Chips & Format Tips -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Chọn loại Game -->
                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Button x:Name="BulkChipValorant" Tag="Valorant" Click="BulkChipGame_Click" Margin="0,0,6,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="#28110E" BorderBrush="#E8321A" BorderThickness="1.5" CornerRadius="6" Padding="10,5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🎯" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Valorant" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="BulkChipRiot" Tag="Riot Games" Click="BulkChipGame_Click" Margin="0,0,6,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="#181818" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="10,5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔺" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="LMHT / Riot" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="BulkChipSteam" Tag="Steam (CS2)" Click="BulkChipGame_Click" Margin="0,0,6,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="#181818" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="10,5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔵" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Steam / CS2" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="BulkChipOther" Tag="Khác" Click="BulkChipGame_Click" Margin="0,0,0,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="#181818" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="10,5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🟣" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Khác..." Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </WrapPanel>

                        <!-- Gợi ý định dạng nhanh -->
                        <Border Grid.Column="1" Background="#141822" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                            <TextBlock FontSize="10.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="14">
                                <Run Text="💡 Cú pháp nhận dạng: " FontWeight="Bold" Foreground="{StaticResource AccentGold}"/>
                                <Run Text="tk:mk" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentBrass}"/>
                                <Run Text=" hoặc "/>
                                <Run Text="tk:mk:ghi_chú" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentBrass}"/>
                                <Run Text=" (hoặc "/>
                                <Run Text="tk|mk|ghi_chú" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentBrass}"/>
                                <Run Text="). Bạn có thể gõ/sửa ghi chú trực tiếp ở bảng bên dưới!"/>
                            </TextBlock>
                        </Border>
                    </Grid>

                    <!-- Ô Dán Văn Bản Hàng Loạt -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Dán danh sách tài khoản bot / shop gửi vào đây:" Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="0,0,0,4"/>
                        <TextBox Grid.Row="1" x:Name="TxtBulkInput" Height="75" Background="#101319" Foreground="{StaticResource TextPrimary}"
                                 CaretBrush="{StaticResource AccentGold}" BorderBrush="{StaticResource BorderCard}" FontSize="12"
                                 FontFamily="{StaticResource MonoFont}" Padding="8" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" TextChanged="TxtBulkInput_TextChanged"/>
                    </Grid>

                    <!-- Preview Summary & Gán Ghi Chú Nhanh Hàng Loạt -->
                    <Grid Grid.Row="3" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Đếm số lượng -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtBulkCountPreview" Text="Chưa có dữ liệu" Foreground="{StaticResource TextMuted}"
                                       FontSize="11.5" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Tool gán ghi chú chung -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🏷️ Gán nhanh ghi chú mẫu:" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtBulkCommonNote" Width="140" Height="26" Background="#12151B" Foreground="{StaticResource TextPrimary}"
                                     BorderBrush="{StaticResource BorderCard}" CaretBrush="{StaticResource AccentGold}"
                                     FontSize="11.5" Padding="6,2" VerticalAlignment="Center" Margin="0,0,6,0"
                                     ToolTip="Nhập tiền tố ghi chú (VD: Mua shop 22/09)"/>
                            <Button Content="⚡ Áp Dụng" Click="BtnApplyCommonNote_Click"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Height="26" Padding="8,0" FontSize="11" Cursor="Hand"
                                    ToolTip="Áp dụng ghi chú này kèm số thứ tự cho toàn bộ tài khoản bên dưới"/>
                        </StackPanel>
                    </Grid>

                    <!-- Bảng Danh Sách Xem Trước & Sửa Ghi Chú Từng Tài Khoản -->
                    <Border Grid.Row="4" Background="#0C0E14" BorderBrush="{StaticResource BorderCard}" BorderThickness="1"
                            CornerRadius="6" Margin="0,0,0,12" Height="190">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Header Bảng -->
                                <RowDefinition Height="*"/>    <!-- Scrollable Rows -->
                            </Grid.RowDefinitions>

                            <!-- Table Header -->
                            <Border Grid.Row="0" Background="#151A24" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="10,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>  <!-- STT -->
                                        <ColumnDefinition Width="150"/> <!-- TK -->
                                        <ColumnDefinition Width="130"/> <!-- MK -->
                                        <ColumnDefinition Width="*"/>   <!-- Ghi chú / Tên gợi nhớ -->
                                        <ColumnDefinition Width="36"/>  <!-- Xóa -->
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="#" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="Tài Khoản" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="2" Text="Mật Khẩu" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="3" Text="🏷️ Ghi Chú / Tên Gợi Nhớ (Sửa trực tiếp từng acc)" Foreground="{StaticResource AccentGold}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="4" Text="" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Table Rows -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="BulkPreviewItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#1C212E" BorderThickness="0,0,0,1" Padding="10,5" Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36"/>  <!-- STT -->
                                                        <ColumnDefinition Width="150"/> <!-- TK -->
                                                        <ColumnDefinition Width="130"/> <!-- MK -->
                                                        <ColumnDefinition Width="*"/>   <!-- Ghi chú TextBox -->
                                                        <ColumnDefinition Width="36"/>  <!-- Nút Xóa dòng -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- STT -->
                                                    <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat='#{0}'}"
                                                               Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>

                                                    <!-- TK -->
                                                    <TextBlock Grid.Column="1" Text="{Binding Username}" TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource TextPrimary}" FontSize="11.5" FontFamily="{StaticResource MonoFont}"
                                                               VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="{Binding Username}"/>

                                                    <!-- MK -->
                                                    <TextBlock Grid.Column="2" Text="{Binding Password}" TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource VintageEmerald}" FontSize="11.5" FontFamily="{StaticResource MonoFont}"
                                                               VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="{Binding Password}"/>

                                                    <!-- Ô SỬA GHI CHÚ TRỰC TIẾP -->
                                                    <TextBox Grid.Column="3" Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="#101319" Foreground="{StaticResource AccentGold}" BorderBrush="{StaticResource BorderCard}"
                                                             CaretBrush="{StaticResource AccentGold}" FontSize="11.5" Padding="6,3" VerticalAlignment="Center"
                                                             ToolTip="Gõ ghi chú riêng cho tài khoản này (VD: Acc chính, Rank KC2, Có skin Prime...)"/>

                                                    <!-- Nút xóa dòng -->
                                                    <Button Grid.Column="4" Content="✕" Tag="{Binding}" Click="BtnRemoveBulkItem_Click"
                                                            Background="Transparent" BorderThickness="0" Foreground="#E74C3C"
                                                            FontSize="12" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            ToolTip="Xóa tài khoản này khỏi danh sách nhập"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Footer Nút Thao Tác -->
                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1.8*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Hủy" Height="38"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Cursor="Hand" Click="BtnCancelBulkImport_Click"/>

                        <Button x:Name="BtnExecuteBulkImport" Grid.Column="2" Content="💾 Lưu 0 Tài Khoản Vào Két Sắt" Height="38"
                                Style="{StaticResource AccentButtonStyle}"
                                Cursor="Hand" Click="BtnExecuteBulkImport_Click" IsEnabled="False"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>


