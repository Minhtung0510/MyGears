<UserControl x:Class="MyGears.Views.Modules.AccountsModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0D0D0D"
             FontFamily="Segoe UI">

    <Grid>
        <!-- ══════════════════════════════════════════════════
             MÀN HÌNH 1: KHÓA MÃ PIN (LOCKED STATE)
             ══════════════════════════════════════════════════ -->
        <Border x:Name="PanelPinLocked" Background="#0D0D0D" Visibility="Visible">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
                    <!-- Icon Khiên & Khóa -->
                    <Border Width="64" Height="64" CornerRadius="16" Background="#161616"
                            BorderBrush="#E8321A" BorderThickness="1.5" Margin="0,0,0,20"
                            HorizontalAlignment="Center">
                        <TextBlock Text="🔐" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="KHO TÀI KHOẢN GAME" FontSize="18" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Mã Hóa AES-256 • Chống Chụp Trộm Màn Hình" FontSize="12"
                               Foreground="#E8321A" HorizontalAlignment="Center" Margin="0,4,0,24"/>

                    <!-- Form Thiết Lập PIN Lần Đầu -->
                    <StackPanel x:Name="PanelSetupPin" Visibility="Collapsed">
                        <TextBlock Text="Thiết lập mã PIN cá nhân để bảo vệ tài khoản:"
                                   Foreground="#AAA" FontSize="12" Margin="0,0,0,8"/>
                        <PasswordBox x:Name="TxtNewPin" Height="40" Background="#181818" Foreground="White"
                                     BorderBrush="#333" BorderThickness="1" FontSize="15" Padding="10,8"
                                     HorizontalContentAlignment="Center"/>

                        <TextBlock Text="Nhập lại mã PIN xác nhận:"
                                   Foreground="#AAA" FontSize="12" Margin="0,14,0,8"/>
                        <PasswordBox x:Name="TxtConfirmPin" Height="40" Background="#181818" Foreground="White"
                                     BorderBrush="#333" BorderThickness="1" FontSize="15" Padding="10,8"
                                     HorizontalContentAlignment="Center"/>

                        <Button Content="Tạo Mã PIN &amp; Mở Khóa" Height="42" Margin="0,20,0,0"
                                Background="#E8321A" Foreground="White" FontWeight="Bold" FontSize="13"
                                Cursor="Hand" Click="BtnSetupPin_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Form Nhập PIN Để Mở Khóa -->
                    <StackPanel x:Name="PanelEnterPin" Visibility="Visible" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="PinShakeTransform" X="0"/>
                        </StackPanel.RenderTransform>
                        <TextBlock Text="Nhập mã PIN cá nhân để mở khóa danh sách:"
                                   Foreground="#AAA" FontSize="12" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                        <PasswordBox x:Name="TxtUnlockPin" Height="44" Background="#181818" Foreground="White"
                                     BorderBrush="#333" BorderThickness="1" FontSize="18" Padding="12,8"
                                     HorizontalContentAlignment="Center" KeyDown="TxtUnlockPin_KeyDown"/>

                        <Button Content="🔓 Mở Khóa Kho Tài Khoản" Height="42" Margin="0,16,0,0"
                                Background="#E8321A" Foreground="White" FontWeight="Bold" FontSize="13"
                                Cursor="Hand" Click="BtnUnlock_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Thông báo lỗi PIN -->
                    <TextBlock x:Name="LblPinError" Text="" Foreground="#E74C3C" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════
             MÀN HÌNH 2: DANH SÁCH TÀI KHOẢN (UNLOCKED STATE)
             ══════════════════════════════════════════════════ -->
        <Grid x:Name="PanelAccountsList" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Thanh công cụ & Badge bảo mật -->
                <RowDefinition Height="Auto"/> <!-- Thanh đếm ngược tự xóa clipboard -->
                <RowDefinition Height="*"/>    <!-- Danh sách thẻ tài khoản -->
            </Grid.RowDefinitions>

            <!-- 1. Thanh Công Cụ & Trạng Thái Bảo Mật -->
            <Border Grid.Row="0" Background="#111111" BorderBrush="#1C1C1C" BorderThickness="0,0,0,1" Padding="16,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Nút Thêm Tài Khoản -->
                        <Button Content="+ Thêm Tài Khoản Mới" Background="#E8321A" Foreground="White"
                                FontWeight="SemiBold" FontSize="12" Padding="14,7" Margin="0,0,12,0"
                                Cursor="Hand" Click="BtnAddAccount_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Nút Chuyển Đổi Bật/Tắt Chống Chụp Màn Hình -->
                        <Button x:Name="BtnToggleAntiCapture" Click="BtnToggleAntiCapture_Click"
                                Background="#1F1A10" BorderBrush="#F39C12" BorderThickness="1"
                                Cursor="Hand" VerticalAlignment="Center" Padding="8,4"
                                ToolTip="Bấm để chuyển đổi Bật/Tắt chế độ chống chụp trộm màn hình">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtAntiCaptureIcon" Text="📷" FontSize="11" Margin="0,0,5,0"/>
                                <TextBlock x:Name="TxtAntiCaptureStatus" Text="Chống Chụp: TẮT (Cho phép chụp)" Foreground="#F39C12" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Nút Khóa Ngay -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="🔒 Khóa Kho" Background="#1E1E1E" Foreground="#AAA"
                                FontSize="11" Padding="10,6" Cursor="Hand" Click="BtnLockVault_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="#333" BorderThickness="1"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Thanh Thông Báo & Đếm Ngược Xóa Clipboard -->
            <Border x:Name="ToastClipboardWipe" Grid.Row="1" Background="#16331E" BorderBrush="#2ECC71"
                    BorderThickness="0,0,0,1" Padding="16,8" Visibility="Collapsed">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✅" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtClipboardNotice"
                                   Text="Đã copy theo định dạng tk:mk! Bộ nhớ tạm sẽ tự động xóa sau 25 giây để bảo mật."
                                   Foreground="#A9DFBF" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0" Foreground="#AAA"
                            FontSize="11" Cursor="Hand" Click="DismissToast_Click"/>
                </Grid>
            </Border>

            <!-- 3. Danh Sách Thẻ Tài Khoản -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="16">
                <StackPanel>
                    <!-- Danh sách hiển thị -->
                    <ItemsControl x:Name="AccountsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InteractiveCardBorderStyle}"
                                        Padding="16" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Trái: Thông tin tài khoản -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <!-- Huy hiệu Game -->
                                                <Border Background="#251210" BorderBrush="#E8321A" BorderThickness="1"
                                                        CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Game}" Foreground="#FF6B4A" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                                <!-- Tên gợi nhớ -->
                                                <TextBlock Text="{Binding Label}" Foreground="White" FontSize="14" FontWeight="Bold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Tên đăng nhập & Mật khẩu -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="Tài khoản: " Foreground="#666" FontSize="12"/>
                                                <TextBlock Text="{Binding Username}" Foreground="#DDD" FontSize="12" FontFamily="Consolas" FontWeight="SemiBold"/>
                                                <TextBlock Text="   |   Mật khẩu: " Foreground="#666" FontSize="12"/>
                                                <TextBlock x:Name="TxtMaskedPass" Text="••••••••" Foreground="#DDD" FontSize="12" FontFamily="Consolas"/>
                                                <TextBlock x:Name="TxtRealPass" Text="{Binding Password}" Foreground="#2ECC71" FontSize="12" FontFamily="Consolas" Visibility="Collapsed"/>
                                                <!-- Nút xem mắt -->
                                                <Button Content="👁️" FontSize="10" Background="Transparent" BorderThickness="0"
                                                        Foreground="#888" Cursor="Hand" Margin="6,0,0,0"
                                                        Click="BtnToggleShowPass_Click"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Phải: Các nút Copy & Quản lý -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- NÚT CHÍNH: COPY ĐỊNH DẠNG tk:mk -->
                                            <Button Tag="{Binding}" Click="BtnCopyCombo_Click"
                                                    Background="#E8321A" Foreground="White"
                                                    FontWeight="Bold" FontSize="12" Padding="12,8"
                                                    Margin="0,0,8,0" Cursor="Hand"
                                                    ToolTip="Copy theo chuẩn tk:mk (sẽ tự xóa sau 25s)">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="📋" Margin="0,0,5,0"/>
                                                                <TextBlock Text="Copy tk:mk"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Copy lẻ User -->
                                            <Button Content="Copy TK" Tag="{Binding Username}" Click="BtnCopySingle_Click"
                                                    Background="#1E1E1E" Foreground="#BBB" FontSize="11" Padding="8,8"
                                                    Margin="0,0,6,0" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="#333" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Copy lẻ Pass -->
                                            <Button Content="Copy MK" Tag="{Binding Password}" Click="BtnCopyPass_Click"
                                                    Background="#1E1E1E" Foreground="#BBB" FontSize="11" Padding="8,8"
                                                    Margin="0,0,10,0" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="#333" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Sửa -->
                                            <Button Content="✏️" Tag="{Binding}" Click="BtnEditAccount_Click"
                                                    Background="Transparent" BorderThickness="0" Foreground="#888"
                                                    FontSize="13" Margin="0,0,6,0" Cursor="Hand" ToolTip="Chỉnh sửa"/>

                                            <!-- Xóa -->
                                            <Button Content="🗑️" Tag="{Binding}" Click="BtnDeleteAccount_Click"
                                                    Background="Transparent" BorderThickness="0" Foreground="#888"
                                                    FontSize="13" Cursor="Hand" ToolTip="Xóa tài khoản"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Thông báo khi trống danh sách -->
                    <Border x:Name="PanelEmptyAccounts" Background="#111111" BorderBrush="#1C1C1C" BorderThickness="1"
                            CornerRadius="8" Padding="30" Margin="0,20,0,0" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🎮" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Chưa có tài khoản nào được lưu." Foreground="#888" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Bấm nút '+ Thêm Tài Khoản Mới' ở góc trên để lưu tài khoản Valorant, Steam, v.v." Foreground="#555" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ══════════════════════════════════════════════════
             MODAL: THÊM / SỬA TÀI KHOẢN (DIALOG OVERLAY)
             ══════════════════════════════════════════════════ -->
        <Border x:Name="ModalAccountEditor" Background="#EE080808" Panel.ZIndex="100" Visibility="Collapsed">
            <Border Width="420" Background="#131313" BorderBrush="#252525" BorderThickness="1"
                    CornerRadius="8" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="TxtModalTitle" Text="Thêm Tài Khoản Mới" FontSize="16"
                               FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

                    <!-- Chọn Game / Nền Tảng -->
                    <TextBlock Text="Chọn Game / Nền tảng:" Foreground="#DDD" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,14">
                        <!-- Chip Valorant -->
                        <Button x:Name="ChipValorant" Tag="Valorant" Click="ChipGame_Click" Margin="0,0,8,8" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#28110E" BorderBrush="#E8321A" BorderThickness="1.5" CornerRadius="6" Padding="12,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔴" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Valorant" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Chip Steam / CS2 -->
                        <Button x:Name="ChipSteam" Tag="Steam (CS2)" Click="ChipGame_Click" Margin="0,0,8,8" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#181818" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="12,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔵" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Steam / CS2" Foreground="#AAA" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Chip Riot Games -->
                        <Button x:Name="ChipRiot" Tag="Riot Games" Click="ChipGame_Click" Margin="0,0,8,8" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#181818" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="12,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔺" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Riot Games (LMHT)" Foreground="#AAA" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Chip Epic Games -->
                        <Button x:Name="ChipEpic" Tag="Epic Games" Click="ChipGame_Click" Margin="0,0,8,8" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#181818" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="12,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Epic Games" Foreground="#AAA" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Chip Khác -->
                        <Button x:Name="ChipOther" Tag="Khác" Click="ChipGame_Click" Margin="0,0,8,8" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#181818" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="12,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🟣" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Khác..." Foreground="#AAA" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </WrapPanel>

                    <!-- Tên Gợi Nhớ -->
                    <TextBlock Text="Tên gợi nhớ (VD: Acc Main Full Skin, Acc Smurf):" Foreground="#AAA" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtEditLabel" Height="38" Background="#1C1C1C" Foreground="White"
                             CaretBrush="White" BorderBrush="#333" FontSize="13" Padding="10,8" Margin="0,0,0,14"/>

                    <!-- Tài Khoản (Username) -->
                    <TextBlock Text="Tên đăng nhập (Username):" Foreground="#AAA" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtEditUsername" Height="38" Background="#1C1C1C" Foreground="White"
                             CaretBrush="White" BorderBrush="#333" FontSize="13" Padding="10,8" Margin="0,0,0,14"/>

                    <!-- Mật Khẩu -->
                    <TextBlock Text="Mật khẩu (Password):" Foreground="#AAA" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtEditPassword" Height="38" Background="#1C1C1C" Foreground="White"
                             CaretBrush="White" BorderBrush="#333" FontSize="13" Padding="10,8" Margin="0,0,0,20"/>

                    <!-- Nút Lưu & Hủy -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Hủy" Height="38" Background="#202020" Foreground="#AAA"
                                FontSize="13" Cursor="Hand" Click="BtnCancelEdit_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="2" Content="💾 Lưu Tài Khoản" Height="38" Background="#E8321A" Foreground="White"
                                FontWeight="Bold" FontSize="13" Cursor="Hand" Click="BtnSaveAccount_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
