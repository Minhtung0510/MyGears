<UserControl x:Class="MyGears.Views.Modules.AccountsModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDeep}"
             FontFamily="{StaticResource AppFont}">

    <Grid>
        <!-- ══════════════════════════════════════════════════
             MÀN HÌNH 1: KHÓA MÃ PIN (ANTIQUE BRASS SAFE VAULT)
             ══════════════════════════════════════════════════ -->
        <Border x:Name="PanelPinLocked" Background="{StaticResource BgDeep}" Visibility="Visible">
            <Grid>
                <!-- Decorative subtle gear watermark -->
                <Canvas IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.035">
                    <TextBlock Text="⚙" FontSize="420" Foreground="{StaticResource AccentBrass}"
                               Margin="-210,-210,0,0" Style="{StaticResource SlowGearSpinStyle}"/>
                </Canvas>

                <!-- Cửa Két Sắt Kim Loại Cổ Điển (Antique Vault Door Assembly) -->
                <Border Width="480" Background="{StaticResource ChassisRackGradient}"
                        BorderBrush="{StaticResource BrassBezelGradient}" BorderThickness="2"
                        CornerRadius="14" Padding="32,28" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.8"/>
                    </Border.Effect>
                    <Grid>
                        <!-- 4 Then chốt thép cơ học hai bên két sắt (Mechanical Vault Locking Bolts) -->
                        <Canvas IsHitTestVisible="False">
                            <Border Canvas.Left="-44" Canvas.Top="50" Width="24" Height="14" CornerRadius="2"
                                    Background="{StaticResource BrushedBrassGradient}" BorderBrush="#3A2A12" BorderThickness="1"/>
                            <Border Canvas.Left="-44" Canvas.Top="160" Width="24" Height="14" CornerRadius="2"
                                    Background="{StaticResource BrushedBrassGradient}" BorderBrush="#3A2A12" BorderThickness="1"/>
                            <Border Canvas.Right="-44" Canvas.Top="50" Width="24" Height="14" CornerRadius="2"
                                    Background="{StaticResource BrushedBrassGradient}" BorderBrush="#3A2A12" BorderThickness="1"/>
                            <Border Canvas.Right="-44" Canvas.Top="160" Width="24" Height="14" CornerRadius="2"
                                    Background="{StaticResource BrushedBrassGradient}" BorderBrush="#3A2A12" BorderThickness="1"/>
                        </Canvas>

                        <StackPanel HorizontalAlignment="Center" Width="380">
                            <!-- Vòng Xoay Mật Mã Tròn Trung Tâm (Rotary Combination Dial) -->
                            <Grid Width="120" Height="120" Margin="0,0,0,18" HorizontalAlignment="Center">
                                <!-- Vành số ngoài dập răng cưa (Knurled Dial Ring) -->
                                <Ellipse Width="120" Height="120" Fill="{StaticResource DialFaceGradient}"
                                         Stroke="{StaticResource BrassBezelGradient}" StrokeThickness="3"/>
                                <!-- Vạch chia độ mật mã -->
                                <Canvas Width="120" Height="120">
                                    <Path Data="M 15,60 A 45,45 0 1 1 105,60" Stroke="#7C6538" StrokeThickness="1.5"/>
                                    <TextBlock Text="0" Canvas.Left="56" Canvas.Top="12" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentGold}" FontFamily="{StaticResource MonoFont}"/>
                                    <TextBlock Text="25" Canvas.Left="94" Canvas.Top="52" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentGold}" FontFamily="{StaticResource MonoFont}"/>
                                    <TextBlock Text="50" Canvas.Left="53" Canvas.Top="94" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentGold}" FontFamily="{StaticResource MonoFont}"/>
                                    <TextBlock Text="75" Canvas.Left="14" Canvas.Top="52" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentGold}" FontFamily="{StaticResource MonoFont}"/>
                                </Canvas>
                                <!-- Trục tay quay 3 chấu (Crossed Wheel Spoke) -->
                                <Grid Style="{StaticResource SlowGearSpinStyle}">
                                    <Rectangle Width="80" Height="8" Fill="{StaticResource BrushedBrassGradient}" RadiusX="2" RadiusY="2"/>
                                    <Rectangle Width="8" Height="80" Fill="{StaticResource BrushedBrassGradient}" RadiusX="2" RadiusY="2"/>
                                </Grid>
                                <!-- Núm vặn trung tâm (Center Brass Hub) -->
                                <Border Width="40" Height="40" CornerRadius="20"
                                        Background="{StaticResource PlateBevelGradient}"
                                        BorderBrush="{StaticResource AccentBrass}" BorderThickness="1.5">
                                    <TextBlock Text="🔒" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="KHO MẬT MÃ CƠ HỌC • AES-256" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}"/>
                            <TextBlock Text="Cơ Chế Bảo Vệ Chống Chụp Trộm • Tự Xóa Clipboard Sau 25s" FontSize="11"
                                       Foreground="{StaticResource AccentGold}" HorizontalAlignment="Center" Margin="0,4,0,20"/>

                            <!-- Form Thiết Lập PIN Lần Đầu -->
                            <StackPanel x:Name="PanelSetupPin" Visibility="Collapsed">
                                <TextBlock Text="Thiết lập mã PIN cá nhân để bảo vệ tài khoản:"
                                           Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,8"/>
                                <PasswordBox x:Name="TxtNewPin" Height="42" Background="#12151B" Foreground="{StaticResource TextPrimary}"
                                             CaretBrush="{StaticResource AccentGold}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1"
                                             FontSize="16" Padding="10,8" HorizontalContentAlignment="Center"/>

                                <TextBlock Text="Nhập lại mã PIN xác nhận:"
                                           Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,14,0,8"/>
                                <PasswordBox x:Name="TxtConfirmPin" Height="42" Background="#12151B" Foreground="{StaticResource TextPrimary}"
                                             CaretBrush="{StaticResource AccentGold}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1"
                                             FontSize="16" Padding="10,8" HorizontalContentAlignment="Center"/>

                                <Button Content="Tạo Mã PIN &amp; Mở Khóa" Height="44" Margin="0,22,0,0"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Cursor="Hand" Click="BtnSetupPin_Click"/>
                            </StackPanel>

                            <!-- Form Nhập PIN Để Mở Khóa -->
                            <StackPanel x:Name="PanelEnterPin" Visibility="Visible" RenderTransformOrigin="0.5,0.5">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="PinShakeTransform" X="0"/>
                                </StackPanel.RenderTransform>
                                <TextBlock Text="Nhập mã PIN cá nhân để xoay chốt mở két sắt:"
                                           Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                                <PasswordBox x:Name="TxtUnlockPin" Height="46" Background="#0F1218" Foreground="{StaticResource TextPrimary}"
                                             CaretBrush="{StaticResource AccentGold}" BorderBrush="{StaticResource AccentBrass}" BorderThickness="1.2"
                                             FontSize="20" Padding="12,8" HorizontalContentAlignment="Center" KeyDown="TxtUnlockPin_KeyDown"/>

                                <Button Content="🔓 MỞ KHÓA KHO TÀI KHOẢN" Height="44" Margin="0,18,0,0"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Cursor="Hand" Click="BtnUnlock_Click"/>
                            </StackPanel>

                            <!-- Thông báo lỗi PIN -->
                            <TextBlock x:Name="LblPinError" Text="" Foreground="{StaticResource VintageRuby}" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════
             MÀN HÌNH 2: DANH SÁCH TÀI KHOẢN (UNLOCKED STATE)
             ══════════════════════════════════════════════════ -->
        <Grid x:Name="PanelAccountsList" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Thanh công cụ & Badge bảo mật -->
                <RowDefinition Height="Auto"/> <!-- Thanh đếm ngược tự xóa clipboard -->
                <RowDefinition Height="*"/>    <!-- Danh sách thẻ tài khoản -->
            </Grid.RowDefinitions>

            <!-- 1. Thanh Công Cụ & Trạng Thái Bảo Mật -->
            <Border Grid.Row="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="18,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Nút Thêm Tài Khoản -->
                        <Button Content="+ Thêm Tài Khoản Mới"
                                Style="{StaticResource AccentButtonStyle}"
                                Height="36" Padding="16,0" Margin="0,0,12,0"
                                FontSize="12" Cursor="Hand" Click="BtnAddAccount_Click"/>

                        <!-- Nút Chuyển Đổi Bật/Tắt Chống Chụp Màn Hình -->
                        <Button x:Name="BtnToggleAntiCapture" Click="BtnToggleAntiCapture_Click"
                                Background="{StaticResource PlateBevelGradient}" BorderBrush="{StaticResource AccentBrass}" BorderThickness="1"
                                Cursor="Hand" VerticalAlignment="Center" Padding="10,6"
                                ToolTip="Bấm để chuyển đổi Bật/Tắt chế độ chống chụp trộm màn hình">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtAntiCaptureIcon" Text="📷" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtAntiCaptureStatus" Text="Chống Chụp: TẮT (Cho phép chụp)" Foreground="{StaticResource AccentGold}" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Nút Khóa Ngay -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="🔒 Khóa Kho"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="12,6" FontSize="11.5" Cursor="Hand" Click="BtnLockVault_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Thanh Thông Báo & Đếm Ngược Xóa Clipboard -->
            <Border x:Name="ToastClipboardWipe" Grid.Row="1" Background="#10261C" BorderBrush="{StaticResource VintageEmerald}"
                    BorderThickness="0,0,0,1" Padding="16,10" Visibility="Collapsed">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✅" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtClipboardNotice"
                                   Text="Đã copy theo định dạng tk:mk! Bộ nhớ tạm sẽ tự động xóa sau 25 giây để bảo mật."
                                   Foreground="#A7F3D0" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondary}"
                            FontSize="11" Cursor="Hand" Click="DismissToast_Click"/>
                </Grid>
            </Border>

            <!-- 3. Danh Sách Thẻ Tài Khoản -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="18">
                <StackPanel>
                    <!-- Danh sách hiển thị -->
                    <ItemsControl x:Name="AccountsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InteractiveCardBorderStyle}"
                                        Padding="18,14" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Trái: Thông tin tài khoản -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <!-- Huy hiệu Game kiểu đồng thau cổ điển -->
                                                <Border Background="#282012" BorderBrush="{StaticResource AccentBrass}" BorderThickness="1"
                                                        CornerRadius="4" Padding="7,3" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Game}" Foreground="{StaticResource AccentGold}" FontSize="10.5" FontWeight="Bold"/>
                                                </Border>
                                                <!-- Tên gợi nhớ -->
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="Bold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Tên đăng nhập & Mật khẩu -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="Tài khoản: " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                <TextBlock Text="{Binding Username}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="   |   Mật khẩu: " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                <TextBlock x:Name="TxtMaskedPass" Text="••••••••" Foreground="{StaticResource TextSecondary}" FontSize="12" FontFamily="{StaticResource MonoFont}"/>
                                                <TextBlock x:Name="TxtRealPass" Text="{Binding Password}" Foreground="{StaticResource VintageEmerald}" FontSize="12" FontFamily="{StaticResource MonoFont}" Visibility="Collapsed"/>

                                                <!-- Nút xem mắt -->
                                                <Button Content="👁️" FontSize="10" Background="Transparent" BorderThickness="0"
                                                        Foreground="{StaticResource TextSecondary}" Cursor="Hand" Margin="8,0,0,0"
                                                        Click="BtnToggleShowPass_Click"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Phải: Các nút Copy & Quản lý -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- NÚT CHÍNH: COPY ĐỊNH DẠNG tk:mk -->
                                            <Button Tag="{Binding}" Click="BtnCopyCombo_Click"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Height="36" Padding="14,0" FontSize="11.5"
                                                    Margin="0,0,8,0" Cursor="Hand"
                                                    ToolTip="Copy theo chuẩn tk:mk (sẽ tự xóa sau 25s)">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📋" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Copy tk:mk"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Copy lẻ User -->
                                            <Button Content="Copy TK" Tag="{Binding Username}" Click="BtnCopySingle_Click"
                                                    Style="{StaticResource ToolbarButtonStyle}"
                                                    Padding="10,6" FontSize="11" Margin="0,0,6,0" Cursor="Hand"/>

                                            <!-- Copy lẻ Pass -->
                                            <Button Content="Copy MK" Tag="{Binding Password}" Click="BtnCopyPass_Click"
                                                    Style="{StaticResource ToolbarButtonStyle}"
                                                    Padding="10,6" FontSize="11" Margin="0,0,10,0" Cursor="Hand"/>

                                            <!-- Sửa -->
                                            <Button Content="✏️" Tag="{Binding}" Click="BtnEditAccount_Click"
                                                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondary}"
                                                    FontSize="13" Margin="0,0,6,0" Cursor="Hand" ToolTip="Chỉnh sửa"/>

                                            <!-- Xóa -->
                                            <Button Content="🗑️" Tag="{Binding}" Click="BtnDeleteAccount_Click"
                                                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondary}"
                                                    FontSize="13" Cursor="Hand" ToolTip="Xóa tài khoản"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Thông báo khi trống danh sách: Hộc Két Sắt Mật Mã Cổ Điển -->
                    <Border x:Name="PanelEmptyAccounts" Background="{StaticResource ChassisRackGradient}"
                            BorderBrush="{StaticResource BrassBezelGradient}" BorderThickness="1.5"
                            CornerRadius="12" Padding="40,32" Margin="20,30,20,0" Visibility="Collapsed" HorizontalAlignment="Center" MaxWidth="540">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity="0.75"/>
                        </Border.Effect>
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Ổ Khóa Đồng Thau Cổ Điển -->
                            <Border Width="68" Height="68" CornerRadius="34" Margin="0,0,0,16" HorizontalAlignment="Center"
                                    Background="{StaticResource PlateBevelGradient}"
                                    BorderBrush="{StaticResource AccentBrass}" BorderThickness="1.5">
                                <Border.Effect>
                                    <DropShadowEffect Color="{StaticResource AccentAmberColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.6"/>
                                </Border.Effect>
                                <TextBlock Text="🗝️" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="KHO HỘC KÉT SẮT CHƯA CÓ DỮ LIỆU" Foreground="{StaticResource AccentGold}" FontSize="14.5" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}"/>
                            <TextBlock Text="Các tài khoản game (Steam, Valorant, Riot...) được mã hóa AES-256 an toàn và tự xóa bộ nhớ tạm sau khi copy."
                                       Foreground="{StaticResource TextSecondary}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,20"/>

                            <Button Content="➕ THÊM TÀI KHOẢN ĐẦU TIÊN VÀO KÉT" Click="BtnAddAccount_Click"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Height="42" Padding="24,0" FontSize="12.5" Cursor="Hand" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ══════════════════════════════════════════════════
             MODAL: THÊM / SỬA TÀI KHOẢN (DIALOG OVERLAY)
             ══════════════════════════════════════════════════ -->
        <Border x:Name="ModalAccountEditor" Background="#E60A0D12" Panel.ZIndex="100" Visibility="Collapsed">
            <Border Width="440" Background="{StaticResource BgDeep}" BorderBrush="{StaticResource AccentBrass}" BorderThickness="1.2"
                    CornerRadius="10" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.85"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="TxtModalTitle" Text="Thêm Tài Khoản Mới" FontSize="16"
                               FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

                    <!-- Chọn Game / Nền Tảng -->
                    <TextBlock Text="Chọn Game / Nền tảng:" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,14">
                        <!-- Chip Valorant -->
                        <Button x:Name="ChipValorant" Tag="Valorant" Click="ChipGame_Click" Margin="0,0,8,8" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#281A10" BorderBrush="{StaticResource AccentBrass}" BorderThickness="1.5" CornerRadius="6" Padding="12,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔴" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Valorant" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Chip Steam / CS2 -->
                        <Button x:Name="ChipSteam" Tag="Steam (CS2)" Click="ChipGame_Click" Margin="0,0,8,8" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{StaticResource PlateBevelGradient}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="6" Padding="12,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔵" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Steam / CS2" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Chip Riot Games -->
                        <Button x:Name="ChipRiot" Tag="Riot Games" Click="ChipGame_Click" Margin="0,0,8,8" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{StaticResource PlateBevelGradient}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="6" Padding="12,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔺" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Riot Games (LMHT)" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Chip Epic Games -->
                        <Button x:Name="ChipEpic" Tag="Epic Games" Click="ChipGame_Click" Margin="0,0,8,8" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{StaticResource PlateBevelGradient}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="6" Padding="12,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Epic Games" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Chip Khác -->
                        <Button x:Name="ChipOther" Tag="Khác" Click="ChipGame_Click" Margin="0,0,8,8" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{StaticResource PlateBevelGradient}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="6" Padding="12,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🟣" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Khác..." Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </WrapPanel>

                    <!-- Tên Gợi Nhớ -->
                    <TextBlock Text="Tên gợi nhớ (VD: Acc Main Full Skin, Acc Smurf):" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtEditLabel" Height="38" Background="#12151B" Foreground="{StaticResource TextPrimary}"
                             CaretBrush="{StaticResource AccentGold}" BorderBrush="{StaticResource BorderCard}" FontSize="13" Padding="10,8" Margin="0,0,0,14"/>

                    <!-- Tài Khoản (Username) -->
                    <TextBlock Text="Tên đăng nhập (Username):" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtEditUsername" Height="38" Background="#12151B" Foreground="{StaticResource TextPrimary}"
                             CaretBrush="{StaticResource AccentGold}" BorderBrush="{StaticResource BorderCard}" FontSize="13" Padding="10,8" Margin="0,0,0,14"/>

                    <!-- Mật Khẩu -->
                    <TextBlock Text="Mật khẩu (Password):" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtEditPassword" Height="38" Background="#12151B" Foreground="{StaticResource TextPrimary}"
                             CaretBrush="{StaticResource AccentGold}" BorderBrush="{StaticResource BorderCard}" FontSize="13" Padding="10,8" Margin="0,0,0,22"/>

                    <!-- Nút Lưu & Hủy -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Hủy" Height="40"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Cursor="Hand" Click="BtnCancelEdit_Click"/>

                        <Button Grid.Column="2" Content="💾 Lưu Tài Khoản" Height="40"
                                Style="{StaticResource AccentButtonStyle}"
                                Cursor="Hand" Click="BtnSaveAccount_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
