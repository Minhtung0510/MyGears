<UserControl x:Class="MyGears.Views.Modules.MouseModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource BgDeep}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🖱️  Chuột — ScyRox V6" Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                    <Border Background="#252525" CornerRadius="3" Padding="6,2" Margin="10,0,0,0">
                        <TextBlock x:Name="StatusBadge" Text="● Đang kết nối…"
                                   Foreground="#FFA500" FontSize="11"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnRestart" Content="↺ Khởi động lại" Margin="6,0"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="BtnRestart_Click"/>
                    <Button x:Name="BtnToggleDetach" Content="⤴ Tách cửa sổ" Margin="6,0"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="BtnToggleDetach_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Container nhúng cửa sổ ScyRox vào đây (màu trùng khớp tuyệt đối với viền ScyRox #0A0606) -->
        <Border x:Name="ScyRoxContainer" Grid.Row="1" Background="#0A0606"/>

        <!-- Placeholder khi ScyRox đang tải hoặc chưa sẵn sàng -->
        <Grid x:Name="PlaceholderPanel" Grid.Row="1" Background="{StaticResource BgSurface}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Loading Spinner xoay vô hạn quanh icon Chuột -->
                <Border Width="64" Height="64" Margin="0,0,0,14" HorizontalAlignment="Center">
                    <Grid>
                        <TextBlock Text="⚙" FontSize="44" Foreground="{StaticResource AccentGold}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Style="{StaticResource SpinningStyle}"/>
                        <TextBlock Text="🖱️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <TextBlock Text="ScyRox V6" FontSize="22" Foreground="{StaticResource TextPrimary}"
                           HorizontalAlignment="Center" Margin="0,0,0,6"
                           FontWeight="Bold"/>
                <TextBlock x:Name="StatusMessage" Text="Đang tự động khởi động và nhúng ScyRox V6…"
                           Foreground="{StaticResource TextSecondary}" FontSize="13"
                           HorizontalAlignment="Center"/>
                <ProgressBar x:Name="LoadingSpinner" IsIndeterminate="True"
                             Height="4" Width="220" Margin="0,12" HorizontalAlignment="Center"/>
                <TextBlock x:Name="StatusSubtext" Text="Vui lòng chờ trong giây lát…"
                           Foreground="{StaticResource TextMuted}" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                <TextBlock x:Name="ScyRoxPathText" Foreground="#555" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,10,0,0"
                           FontFamily="Consolas"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
