<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════
         MyGears — Vintage Mechanical & Amber Console Theme
         Phong cách: Bảng điều khiển cơ khí cổ điển, đồng thau & hổ phách
         ══════════════════════════════════════════════════════════════ -->

    <!-- ── Colors ──────────────────────────────────────────────── -->
    <!-- Nền kim loại phay xước & phiến đá cổ điển (Dark Gunmetal & Slate) -->
    <Color x:Key="BgDeepColor">#0E1013</Color>
    <Color x:Key="BgSidebarColor">#13161C</Color>
    <Color x:Key="BgContentColor">#161921</Color>
    <Color x:Key="BgSurfaceColor">#1A1E27</Color>
    <Color x:Key="BgElevatedColor">#212632</Color>
    <Color x:Key="BgCardColor">#1A1E27</Color>
    <Color x:Key="BgCardHoverColor">#242A36</Color>

    <!-- Đồng Thau Cổ Điển & Ánh Hổ Phách Đèn Chân Không (Brass & Amber Glow) -->
    <Color x:Key="AccentBrassColor">#D4AF37</Color>
    <Color x:Key="AccentGoldColor">#F5C26B</Color>
    <Color x:Key="AccentAmberColor">#FF9E3B</Color>
    <Color x:Key="AccentRedColor">#E58226</Color>       <!-- Đồng ánh hổ phách thay cho đỏ thuần -->
    <Color x:Key="AccentOrangeColor">#FFB703</Color>
    <Color x:Key="AccentGlowColor">#FF9E3B</Color>

    <!-- Đèn chỉ báo ngọc / Nixie (Jewel Indicators) -->
    <Color x:Key="VintageEmeraldColor">#10B981</Color>
    <Color x:Key="VintageEmeraldGlowColor">#34D399</Color>
    <Color x:Key="VintageRubyColor">#EF4444</Color>

    <!-- Chữ Giấy Cổ Điển (Antique Parchment & Silver) -->
    <Color x:Key="TextPrimaryColor">#F6F4EE</Color>
    <Color x:Key="TextSecondaryColor">#B8B4AC</Color>
    <Color x:Key="TextMutedColor">#78716C</Color>

    <!-- Đường Viền Kim Loại Vát Cạnh (Machined Bevel Borders) -->
    <Color x:Key="BorderSubtleColor">#252A36</Color>
    <Color x:Key="BorderCardColor">#323847</Color>
    <Color x:Key="BorderActiveColor">#D4AF37</Color>

    <!-- ── Solid Brushes ───────────────────────────────────────── -->
    <SolidColorBrush x:Key="BgDeep"        Color="{StaticResource BgDeepColor}"/>
    <SolidColorBrush x:Key="BgSidebar"     Color="{StaticResource BgSidebarColor}"/>
    <SolidColorBrush x:Key="BgContent"     Color="{StaticResource BgContentColor}"/>
    <SolidColorBrush x:Key="BgSurface"     Color="{StaticResource BgSurfaceColor}"/>
    <SolidColorBrush x:Key="BgElevated"    Color="{StaticResource BgElevatedColor}"/>
    <SolidColorBrush x:Key="BgCard"        Color="{StaticResource BgCardColor}"/>
    <SolidColorBrush x:Key="BgCardHover"   Color="{StaticResource BgCardHoverColor}"/>

    <SolidColorBrush x:Key="AccentBrass"   Color="{StaticResource AccentBrassColor}"/>
    <SolidColorBrush x:Key="AccentGold"    Color="{StaticResource AccentGoldColor}"/>
    <SolidColorBrush x:Key="AccentAmber"   Color="{StaticResource AccentAmberColor}"/>
    <SolidColorBrush x:Key="AccentRed"     Color="{StaticResource AccentRedColor}"/>
    <SolidColorBrush x:Key="AccentOrange"  Color="{StaticResource AccentOrangeColor}"/>
    <SolidColorBrush x:Key="AccentGlow"    Color="{StaticResource AccentGlowColor}"/>

    <SolidColorBrush x:Key="VintageEmerald" Color="{StaticResource VintageEmeraldColor}"/>
    <SolidColorBrush x:Key="VintageRuby"    Color="{StaticResource VintageRubyColor}"/>

    <SolidColorBrush x:Key="TextPrimary"   Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMuted"     Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="BorderSubtle"  Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="BorderCard"    Color="{StaticResource BorderCardColor}"/>
    <SolidColorBrush x:Key="BorderActive"  Color="{StaticResource BorderActiveColor}"/>

    <!-- ── Gradients ───────────────────────────────────────────── -->
    <!-- Dải màu Đồng Thau Hoàng Gia sang Hổ Phách rực rỡ -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F5C26B" Offset="0.0"/>
        <GradientStop Color="#D4AF37" Offset="0.45"/>
        <GradientStop Color="#E58226" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Dải màu Đồng Thau Phay Xước (Brushed Brass) -->
    <LinearGradientBrush x:Key="BrushedBrassGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#C5A059" Offset="0.0"/>
        <GradientStop Color="#F3C05B" Offset="0.5"/>
        <GradientStop Color="#A67C1E" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Nền kim loại có độ vát 3D nhẹ (Machined Plate Bevel) -->
    <LinearGradientBrush x:Key="PlateBevelGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#232834" Offset="0.0"/>
        <GradientStop Color="#181C25" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Nền mặt đồng hồ đo cổ điển (Vintage Meter Dial Face) -->
    <RadialGradientBrush x:Key="DialFaceGradient" Center="0.5,0.75" GradientOrigin="0.5,0.75" RadiusX="0.75" RadiusY="0.75">
        <GradientStop Color="#2A2216" Offset="0.0"/>
        <GradientStop Color="#18140D" Offset="0.65"/>
        <GradientStop Color="#0F0C08" Offset="1.0"/>
    </RadialGradientBrush>

    <!-- Viền kim loại dập nổi (Beveled Brass Rim) -->
    <LinearGradientBrush x:Key="BrassBezelGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F3C05B" Offset="0.0"/>
        <GradientStop Color="#8C6718" Offset="0.5"/>
        <GradientStop Color="#D4AF37" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Thân máy kim loại thép phay xước (Machined Chassis Slate) -->
    <LinearGradientBrush x:Key="ChassisRackGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#171A21" Offset="0.0"/>
        <GradientStop Color="#12141A" Offset="0.5"/>
        <GradientStop Color="#0D0E12" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- ── Ốc Vít Lục Giác Tán Đồng 4 Góc (Vintage Brass Hex Screw Cap) ── -->
    <Style x:Key="BrassScrewCapStyle" TargetType="Control">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border Width="18" Height="18" CornerRadius="9"
                            Background="{StaticResource PlateBevelGradient}"
                            BorderBrush="{StaticResource AccentBrass}" BorderThickness="1.2">
                        <Grid>
                            <Line X1="3" Y1="9" X2="15" Y2="9" Stroke="{StaticResource AccentGold}" StrokeThickness="1.2"/>
                            <Line X1="9" Y1="3" X2="9" Y2="15" Stroke="{StaticResource AccentGold}" StrokeThickness="1.2"/>
                            <Ellipse Width="6" Height="6" Stroke="{StaticResource AccentBrass}" StrokeThickness="0.8"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Typography ──────────────────────────────────────────── -->
    <FontFamily x:Key="AppFont">Segoe UI, Consolas, Arial, sans-serif</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, 'Cascadia Code', Courier New, monospace</FontFamily>

    <!-- ── Window Style ────────────────────────────────────────── -->
    <Style x:Key="GameWindowStyle" TargetType="Window">
        <Setter Property="Background"       Value="{StaticResource BgDeep}"/>
        <Setter Property="Foreground"       Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily"       Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize"         Value="13"/>
        <Setter Property="WindowStyle"      Value="None"/>
        <Setter Property="AllowsTransparency" Value="False"/>
        <Setter Property="ResizeMode"       Value="CanResizeWithGrip"/>
        <Setter Property="BorderBrush"      Value="{StaticResource AccentBrass}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
    </Style>

    <!-- ── Sidebar Item Button (Vintage Mechanical Switch) ─────── -->
    <Style x:Key="SidebarItemStyle" TargetType="Button">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="Foreground"       Value="{StaticResource TextSecondary}"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Padding"          Value="14,10"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="FontFamily"       Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize"         Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="7"
                            Margin="0,3"
                            Padding="{TemplateBinding Padding}"
                            BorderThickness="1"
                            BorderBrush="Transparent">
                        <Border.Background>
                            <SolidColorBrush x:Name="BdBg" Color="#00000000"/>
                        </Border.Background>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover: Ánh sáng đồng thau nhẹ và viền nổi -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#1F2430" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="BdBg"
                                                        Storyboard.TargetProperty="Color"
                                                        To="#00000000" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#3D4556"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <!-- Pressed: Nút lún xuống như phím cơ -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrass}"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarItemActiveStyle" TargetType="Button" BasedOn="{StaticResource SidebarItemStyle}">
        <Setter Property="Foreground"  Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="7"
                            Margin="0,3"
                            Padding="{TemplateBinding Padding}"
                            BorderThickness="1"
                            BorderBrush="{StaticResource AccentBrass}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#282218" Offset="0"/>
                                <GradientStop Color="#181B22" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource AccentAmberColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                        </Border.Effect>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Nút Bấm Cơ Khí Xúc Giác 3D (Tactile Mechanical Button) ── -->
    <Style x:Key="ToolbarButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="{StaticResource PlateBevelGradient}"/>
        <Setter Property="Foreground"      Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BorderCard}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="12,6"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform x:Name="BtnTrans" Y="0"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect x:Name="BtnShadow" Color="Black" BlurRadius="4" ShadowDepth="2" Opacity="0.4"/>
                        </Border.Effect>
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover: Ánh sáng đồng thau rọi lên viền -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrass}"/>
                            <Setter TargetName="BtnBorder" Property="Background" Value="#252C3A"/>
                            <Setter TargetName="BtnBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource AccentAmberColor}" BlurRadius="10" ShadowDepth="2" Opacity="0.45"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Click: Nút cơ khí lún xuống 1.5px -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBorder" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1.5"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="BtnBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="0.5" Opacity="0.3"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="BtnBorder" Property="Background" Value="#1A1E28"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Nút Nổi Bật Chính (Vintage Primary Accent CTA Button) ──── -->
    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="{StaticResource AccentGradient}"/>
        <Setter Property="Foreground"      Value="#15120E"/>
        <Setter Property="BorderBrush"     Value="{StaticResource AccentGold}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="22,10"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="FontWeight"      Value="Bold"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource AccentAmberColor}"
                                              BlurRadius="14" ShadowDepth="2" Opacity="0.55"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover: Tăng độ rực sáng hổ phách -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource AccentAmberColor}"
                                                      BlurRadius="22" ShadowDepth="2" Opacity="0.85"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.96"/>
                        </Trigger>
                        <!-- Pressed: Nút cơ học ấn sâu xuống -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="2"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource AccentAmberColor}"
                                                      BlurRadius="6" ShadowDepth="0" Opacity="0.4"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Thanh Tiến Trình Vạch Analog (Vintage Segmented Progress) ─ -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height"         Value="8"/>
        <Setter Property="Background"     Value="#12151B"/>
        <Setter Property="Foreground"     Value="{StaticResource AccentGradient}"/>
        <Setter Property="BorderBrush"    Value="{StaticResource BorderCard}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="1">
                        <Border x:Name="PART_Track">
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left"
                                    CornerRadius="3">
                                <Border.Effect>
                                    <DropShadowEffect Color="{StaticResource AccentAmberColor}" BlurRadius="6" ShadowDepth="0" Opacity="0.7"/>
                                </Border.Effect>
                            </Border>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── TextBlock defaults & Crisp Display Rendering ─────────── -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily"  Value="{StaticResource AppFont}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <!-- ── ScrollBar Cổ Điển Mảnh (Vintage Sleek ScrollBar) ─────── -->
    <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SlimScrollThumb" TargetType="Thumb">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
            <Border x:Name="Grip" Background="#505563" CornerRadius="4" Margin="2"/>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#B9964C"/></Trigger>
                <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#FFD166"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Grip" Property="Opacity" Value="0.3"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Background" Value="#101218"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton><RepeatButton x:Name="Before" Style="{StaticResource ScrollTrackButton}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb x:Name="Grip" Style="{StaticResource SlimScrollThumb}" MinWidth="0"/></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton x:Name="After" Style="{StaticResource ScrollTrackButton}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                </Track>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                    <Setter TargetName="Grip" Property="MinHeight" Value="0"/>
                    <Setter TargetName="Grip" Property="MinWidth" Value="24"/>
                    <Setter TargetName="Before" Property="Command" Value="ScrollBar.PageLeftCommand"/>
                    <Setter TargetName="After" Property="Command" Value="ScrollBar.PageRightCommand"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/></Trigger></Style.Triggers>
    </Style>

    <Style x:Key="AccountCardMotion" TargetType="Border">
        <Setter Property="BorderBrush" Value="#232326"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    </Style>

    <!-- ── Bánh Răng Xoay Liên Tục (Gear Infinite Rotation) ─────── -->
    <Style x:Key="SpinningStyle" TargetType="FrameworkElement">
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="0"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                         From="0" To="360" Duration="0:0:1.8"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- ── Bánh Răng Xoay Chậm Êm (Slow Mechanical Gear Idle) ──── -->
    <Style x:Key="SlowGearSpinStyle" TargetType="FrameworkElement">
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="0"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                         From="0" To="360" Duration="0:0:16"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- ── Đèn Sợi Đốt Thở (Filament Bulb Warm Breathing Pulse) ─── -->
    <Style x:Key="FilamentBreathingStyle" TargetType="FrameworkElement">
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0.65" To="1.0" Duration="0:0:1.8">
                            <DoubleAnimation.EasingFunction>
                                <SineEase EasingMode="EaseInOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- ── Thẻ Card Cơ Khí (Vintage Interactive Card) ──────────── -->
    <Style x:Key="InteractiveCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PlateBevelGradient}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderCard}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.45"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1.015" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1.015" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                             To="18" Duration="0:0:0.18"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                             To="0.6" Duration="0:0:0.18"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1.0" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1.0" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                             To="8" Duration="0:0:0.18"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                             To="0.45" Duration="0:0:0.18"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrass}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Tab RadioButton Tactical (Valorant Module) ──────────── -->
    <Style x:Key="TacticalTabRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="{StaticResource PlateBevelGradient}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderCard}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrass}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2A2214"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentGold}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentGold}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Style cho Pill phụ kiện kho đồ ───────────────────────── -->
    <Style x:Key="SubCategoryPillStyle" TargetType="Button">
        <Setter Property="Background" Value="#121622"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderCard}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentGold}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Popup menus use their own visual tree: explicitly theme both container and items. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="#171B24"/>
        <Setter Property="Foreground" Value="#F3F4F6"/>
        <Setter Property="BorderBrush" Value="#485064"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="MinWidth" Value="220"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" MaxHeight="600"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="#F3F4F6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="CheckMark" Text="✓" Visibility="Collapsed" Margin="0,0,8,0"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Arrow" Grid.Column="2" Text="›" Visibility="Collapsed" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" AllowsTransparency="True" Focusable="False">
                            <Border Background="#171B24" BorderBrush="#485064" BorderThickness="1" CornerRadius="7" Padding="5"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#30394A"/><Setter Property="Foreground" Value="#FFD166"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#818896"/></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Separator">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="#343B49" Margin="7,4"/></ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
